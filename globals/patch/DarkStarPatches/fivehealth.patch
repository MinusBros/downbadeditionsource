#export:Function $ShowCustomMessage % ( stringID from Custom section, message display time )
{
	PUSH	RA, S0, S1
	DADDU	S0, A0, R0
	LW		S1, C (A0)
	JAL		~Func:get_variable
	LW		A1, 0 (S1)
	ADDIU	S1, S1, 4
	DADDU	A0, S0, R0
	DADDU	S0, V0, R0
	JAL		~Func:get_variable
	LW		A1, 0 (S1)
	DADDU	S1, V0, R0
	DADDU	A0, R0, R0
	JAL		8024EF68	% CreateMessageBox? (usually at 8029F2C0)
	DADDU	A1, S1, R0
	DADDU	V1, V0, R0
	BEQ		V1, R0, .Done
	NOP
	SW		R0, 0 (V1)
	LIA		V0, $Custom_8024FB3C
	SW		V0, 4 (V1)
	SW		R0, 8 (V1)
	LIA		V0, $Custom_80250EA4
	SW		V0, C (V1)
	SH		S0, 12 (V1)	% message ID
	SH		S1, 14 (V1) % message time
	SB		R0, 16 (V1)
	ADDIU	V0, R0, 1
	SB		V0, 17 (V1)
	SW		R0, 18 (V1)
	SAW		V1, 802838F8
	SAH		R0, 8029F640
	SAH		R0, 8029F64A
	SAH		R0, 8029F64C
	SAH		R0, 8029F64E
	SAH		R0, 8029F650
	.Done
	POP		RA, S0, S1
	JR		RA
	ADDIU	V0, R0, 2
}
	
