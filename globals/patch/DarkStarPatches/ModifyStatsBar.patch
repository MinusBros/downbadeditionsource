%Pause FP text (if above 100, shift right 2 slots) (2 because curr fp has to move too)

%Curr fp (move if max fp is > 100)
@Hook 00139034
{
	PUSH	T0, T1, T2
	LAB		T1, 8010F296
	SLTI	T0, T1, 0064 % < 10
	BNE		T0, R0, .noshift
	NOP
	.shift
	% shift 1 digit right
	ADDIU	A1, A1, 000A	
	.noshift
	% 2 lines we removed, then jump
	POP		T0, T1, T2
	ADDIU	T0, R0, 00FF
	SW		R0, 0010 (SP)
	J		80245CFC
	NOP
}

%Max fp
@Hook 00139084
{
	PUSH	T0, T1
	DADDU	A1, S7, R0
	SLTI	T0, A0, 0064 % < 10
	BNE		T0, R0, .noshift
	NOP
	.shift
	% shift 2 digits right
	ADDIU	A1, A1, 0014
	.noshift
	% 1 line we removed, then jump
	POP		T0, T1
	ADDIU	T0, R0, 00FF
	SW		R0, 0010 (SP)
	J		80245D4C
	NOP
}

%slash
@Hook 00139054
{
	PUSH	T0, T1
	DADDU	A1, S3, R0
	LUI		T1, 8011 % load fp
