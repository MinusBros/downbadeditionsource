 %%% This is mostly an issue for transferring status eligibility to the new enemy (for Duplighost transformations and such.). One LH, one SH. Simple hook.
 
 %8027DCBC + 6C = 8027DD28
 %8027DD28 - 800D1720 = 1AC608
@Hook 1AC608			 %set actor var F to 0202 to ensure all status procs land during carryover
{
	ADDIU	A1, R0, 202
	SW		A1, C4 (S0)  %S0 = target actor
	LB		A1, 210 (S1) %clobbered by hook - run these lines anyway
	J 		8027DD30	 %8027DCBC+74
	LB		A2, 211 (S1)
}
   	
 
 %8027DCBC + BC = 8027DD78
 %8027DD78 - 800D1720 = 1AC658
@Hook 1AC658
{
	SB		R0, 21C (S1)	 %these two lines were clobbered by hook - run them	
	SB		R0, 21C (S0)
	LW		V0, C4 (S1)		 %get source actor var F
	J 		8027DD80		 %8027DCBC+C4
	SW		V0, C4 (S0)		 %copy it to target (V0 is overwritten by return code so it's safe to use)
}
