%Increment each actor HP and damage deal according to the current difficulty.

%Credit to rainchus for the original script.
%Credit to ShyBlookster137 for helping me get the original 0.75x stats to work.
%Credit to Zelly_9191 for rewriting the script to be custom for DBE.

%Difficulty is adjusted by Merlon in Toad Town.
%Very Hard is removed due to Hard already being
%insanely difficult as it is and late-game bosses
%HP not going over 255.

%Difficulties
%00=Easy (0.75x HP & Damage) (Casual)
%01=Normal
%02=Hard (1.5x HP & Damage) (Gamer)
%Unknown values will default to easy.


#new:Function $Function_GetScaleValue
{
    PUSH	RA, A0, A1, A2, V1, V0
    LIO 	A1, *Byte_Settings_Difficulty
    JAL 	~Func:get_variable
    RESERVED
    COPY    V1, V0
    LW      V0, 24 (SP)            % Pop V0
                                   % V0 = value to Change (hp/atk)
                                   % Begin to Check current difficulty
    BEQ     V1, R0, .Easy          % if V1 = 0 (easy) jump to Easy
    ORI     A0, R0, 1              % Prepare to check if Normal
    BEQ     V1, A0, .Final         % if V1 = 1 (normal) jump to final
    ORI     A0, R0, 2              % Prepare to check if Hard
    BEQ     V1, A0, .Hard          % if V1 = 2 (hard) jump to Hard
    NOP
    .Easy
    COPY    T0, V0                 % save the original Value in T0
    ADDU    V0, V0, T0             % value x2
    ADDU    V0, V0, T0             % value x3
    SRL     V0, V0, 2              % divide by 4 to get 75% ((valuex3)/4)
    BEQL    V0, R0, .Final         % if it is not 0 skip the ORI if it is zero preform the ORI and jump to final
    ORI     V0, R0, 1              % if it is 0 set to 1
    BEQ     R0, R0, .Final         % if 0=0 jump to Final
    NOP
    .Hard
    COPY    T0, V0                 % save the original Value in T0
    SRL     V0, V0, 1              % divide value by 2 drop remainder
    ANDI    A0, T0, 1              % check if Value is even or odd and store 0 or 1 in A0. If even store 0 if odd store 1.
    ADDU    V0, V0, T0             % original Value + value to change. store in V0
    ADDU    V0, A0, V0             % Add 1 if odd to simulate rounding up.
    .Final
    SLTIU   T0, V0, 256            % if V0 is 256 or above T0 becomes 0
    BEQL    T0, R0, .End           % if T0 is not 0 skip the ORI if it is zero preform the ORI and jump to final
    ORI     V0, R0, FF             % is above 255, set the HP value back to FF
    .End
    POP		RA, A0, A1, A2, V1, R0
    JR      RA
    NOP
}


                                       % ~Func:create_actor
@Hook 193DE8                           % 80265508
{
    JAL     $Function_GetScaleValue    % calculate scaled hp
    NOP
    SB      V0, 01B8 (S1)              % write it to current hp
    J       80265510
    SB      V0, 01B9 (S1)              % write it to max hp
}


% Change ~DamageType:IgnoreDefense to pierce all player defense
% Instead of only the value from their defense tables.
#export:Function $Function_GetMarioDefense
{
    PUSH    RA, A0, T0, S0
    JAL     $GetActorExtraBattleData_Pointer   % Check Mario's defense.
    CLEAR   A0                                 % this sets .Actor:Player id to 0 as intended
    CLEAR   S0                                 % make S0=0
    LB      T0, E (V0)                         % Check if mario used the defend command (may be vistigial?)
    ADDU    S0, S0, T0                         % If yes add mario's defending defense
	.CheckDefensePlus
    JAL     $IsBadgeActivated_Stack            % Check how many times Mario has the following Badge
    ORI     A0, R0, 00FB                       % .Item:DefendPlusA
	BNEL    V0, R0, .CheckDefensePlus2         % Branch but before you do...
	ADDU    S0, S0, V0                         % Add the number of active badges to S0
	.CheckDefensePlus2
    JAL     $IsBadgeActivated_Stack            % Check how many times Mario has the following Badge
    ORI     A0, R0, 013E                       % .Item:DefendPlusX
	BNEL    V0, R0, .CheckDefensePlus3         % Branch but before you do...
	ADDU    S0, S0, V0                         % Add the number of active badges to S0
	.CheckDefensePlus3
    JAL     $IsBadgeActivated_Stack            % Check how many times Mario has the following Badge
    ORI     A0, R0, 013F                       % .Item:DefendPlus? (DBE defend plus 3?)
	BNEL    V0, R0, .End                       % Branch but before you do...
	ADDU    S0, S0, V0                         % Add the number of active badges to S0
    .End
    COPY    V0, S0                             % Copy S0 to V0 output will be = V0
	POP     RA, A0, T0, S0
	JR	    RA
	NOP
}




                                               % V0 is now free to be used to write the amount of defense to add to the attack power for piercing
                                               % Returns a zero if target wasn't Player/Partner or if IgnoreDefense wasn't present.
#new:Function $PiercePlayerTeamDefense
{
    PUSH    RA, A0, A1, A2, A3, V1
    LW      V0, 188 (S1)                       % S1 = battleStatus
    LUI     V1, 0800                           % load battleStatus(0x188) = currentAttackElement
    AND     V0, V0, V1                         % check for DamageType:IgnoreDefense
    BEQ     V0, R0, .End                       % if it isnt DamageType:IgnoreDefense jump to.End but before you decide if you are going to do that....
    CLEAR   A3                                 % Make A3=0 A3 will be our temporary return value so make it 0
    .GetTargetID
    LHU     V0, 428 (S2) % load targetID       % Check if current target is Mario or something unexpected. S2 = attacker's actor data
    BNE     V0, R0, .End                       % If it's the partner or something unexpected jump to the .End
    NOP
    JAL     $Function_GetMarioDefense
    NOP
    COPY    A3, V0                             % We now mostly have mario's active defense in V0 and we copy that to A3
    .End
    COPY    V0, A3                             % We now copy A3 into V0 in case we are targeting the partner or something unexpected.
    POP     RA, A0, A1, A2, A3, V1
    JR      RA
    NOP
}

                                               % Apply damage boost according to the current difficulty.
                                               % Patch EnemyDamageTarget (API)
@Hook 1AB628                                   % 8027CD48
{
    PUSH    S0
    JAL     $Function_GetScaleValue            % Jump to Function_GetScaleValue but before that...
    NOP                                        % Do Nothing and continue
    JAL     $PiercePlayerTeamDefense           % Jump to PiercePlayerTeamDefense but before that...
    COPY    S0, V0                             % Save scaled attack value in S0
    ADDU    V0, S0, V0                         % Finally we add the scaled attack and mario's defense (0 if partner or not pierce) together
    POP     S0
    % restore vanilla code
    SH	    V0, 017E (S1)
    J       8027CD50
    LW	    A1, 0000 (S0)
}
