/% This file have the drop and hold tables for all enemies in the game.

% I grabbed most data from TTYD, although some enemies have a few
% changes here and there.

I grabbed TTYD's data from jdaster's Enemy Item/Badge Drop GameFAQs' guide

You can take a look at the file to find out more about it:
https://gamefaqs.gamespot.com/gamecube/920182-paper-mario-the-thousand-year-door/faqs/63451

% The game uses the same calculation method to spawn or drop items like TTYD.
% I grabbed all data from jdaster's docs too.

#export:Data $ItemDropTable_Goomba
{
                    Hold Weight     Drop Weight
    itemID              10`s              10`s
    itemID              0`s              10`s
    FFFFFFFF
}
%/

% Enemies item data from the last battle.
%
% Used when trying to drop an item after battle
%
% plus Parakarry's new Steal Item move.
#export:Data $EnemiesItemsBattleData
{
    /%
    % 0x00 - itemTable*
    % 0x04 - u16 spawnedItemID
    % 0x06 - u8 enemyType
         0x01=spawned at the start of the battle
         0x02=actor most in front (start of the battle)
    % 0x07 - u8 itemStolen(byteFlag)
    %/
    00000000 0000`s 00b 00b % Enemy0
    00000000 0000`s 00b 00b % Enemy1
    00000000 0000`s 00b 00b % Enemy2
    00000000 0000`s 00b 00b % Enemy3
    00000000 0000`s 00b 00b % Enemy4
    00000000 0000`s 00b 00b % Enemy5
    00000000 0000`s 00b 00b % Enemy6
    00000000 0000`s 00b 00b % Enemy7
    00000000 0000`s 00b 00b % Enemy8
    00000000 0000`s 00b 00b % Enemy9
    00000000 0000`s 00b 00b % Enemy10
    00000000 0000`s 00b 00b % Enemy11
    00000000 0000`s 00b 00b % Enemy12
    00000000 0000`s 00b 00b % Enemy13
    00000000 0000`s 00b 00b % Enemy14
    00000000 0000`s 00b 00b % Enemy15
    00000000 0000`s 00b 00b % Enemy16
    00000000 0000`s 00b 00b % Enemy17
    00000000 0000`s 00b 00b % Enemy18
    00000000 0000`s 00b 00b % Enemy19
    00000000 0000`s 00b 00b % Enemy20
    00000000 0000`s 00b 00b % Enemy21
    00000000 0000`s 00b 00b % Enemy22
    00000000 0000`s 00b 00b % Enemy23
    FFFFFFFF FFFFFFFF
}

