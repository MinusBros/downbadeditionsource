#new:Script $Script_SetupMusic
{
	Call  SetMusicTrack ( 00000000 .Song:StarshipTheme 00000001 00000008 )
	Call  ClearAmbientSounds ( 250` )
	Return
	End
}



#new:Script $Script_Exit_Entry0
{
	SetGroup 0000001B
	Call     UseExitHeading ( 60` ~Entry:Entry0 )
	Exec     ExitWalk
	Call  GotoMap   ( "mac_10" 1 )
	Wait  100`
	Return
	End
}

#new:Script $Script_CreateExitTriggers
{
	Bind  $Script_Exit_Entry0 .Trigger:FloorAbove ~Collider:loadingzone 00000001 00000000
	Return
	End
}

