	Return
	End
}

#new:Script $Script_Init_Dark
{
	Call	BindNpcInteract ( .Npc:Self $Script_Interact_Dark )
	Return
	End
}

#new:Script $Script_Interact_FatguyKappy
{
	If  *MapFlag[07] == .True
		Call	SpeakToNpc ( .Npc:Fatguy 00E6010B 00E60102 00000000 .Npc:Kappy 00080065 )
		Thread
			Call  InterpNpcYaw   ( .Npc:Kappy 90`  14` )
		EndThread
		Call	SpeakToNpc ( .Npc:Kappy 00E6020B 00E60202 00000005 .Npc:Fatguy 00080066 )
		Call	SpeakToNpc ( .Npc:Fatguy 00E6010B 00E60102 00000000 .Npc:Kappy 00080067 )
		Call	SpeakToNpc ( .Npc:Kappy 00E6020B 00E60202 00000005 .Npc:Fatguy 00080068 )
		Return
	EndIf
	If  *MapFlag[06] == .False
		Call	SpeakToNpc ( .Npc:Fatguy 00E6010B 00E60102 00000000 .Npc:Kappy 00080050 )
		Call  PlaySound     ( 00000237 )
  2C0:  Set   *Var0  0000005A
  2D0:  Loop  00000014
  2DC:  	Add   *Var0  00000090
  2EC:  	If  *Var0  >  00000167
  2FC:  		Sub   *Var0  00000168
  30C:  	EndIf
  314:  	Call  InterpNpcYaw   ( .Npc:Fatguy *Var0  1` )
  328:  	Wait  1`
  334:  EndLoop
		Wait  15`
		Call	SpeakToNpc ( .Npc:Kappy 00E6020B 00E60202 00000000 .Npc:Fatguy 00080051 )
		Call	SpeakToNpc ( .Npc:Fatguy 00E6010B 00E60102 00000000 .Npc:Kappy 00080052 )
		Call    SetMusicTrack ( 00000000 .Song:StarWayOpens 00000002 00000000 )  %Exclusive song
		Wait    15`
		Call	SpeakToNpc ( .Npc:Kappy 00E6020B 00E60202 00000000 .Npc:Fatguy 00080053 )
		Call	SpeakToNpc ( .Npc:Fatguy 00E6010B 00E60102 00000000 .Npc:Kappy 00080054 )
		Wait    15`
		Call    PlaySound     ( 00000006 )
		Wait    10`
		Call  SetMusicTrack ( 00000000 .Song:StarWayOpens 00000002 00000008 )  %Exclusive song
		Set  *MapFlag[06] .True
	Else
		Call	SpeakToNpc ( .Npc:Fatguy 00E6010B 00E60102 00000000 .Npc:Kappy 00080055 )
		Call	SpeakToNpc ( .Npc:Kappy 00E6020B 00E60202 00000000 .Npc:Fatguy 00080056 )
		Call	SpeakToNpc ( .Npc:Fatguy 00E6010B 00E60102 00000000 .Npc:Kappy 00080057 )
		Call	SpeakToNpc ( .Npc:Kappy 00E6020B 00E60202 00000000 .Npc:Fatguy 00080058 )
		Call	SpeakToNpc ( .Npc:Fatguy 00E6010B 00E60102 00000000 .Npc:Kappy 00080059 )
		Call	SpeakToNpc ( .Npc:Kappy 00E6020B 00E60202 00000000 .Npc:Fatguy 0008005A )	
		If  *GF_TYD00_IronClefts == .False
			Set  *MapFlag[07]  .True
		EndIf
	EndIf
	Wait  10`
	Return
	End
}


#new:Script $Script_Interact_Dark
{
	Call  GetSelfVar    ( 0 *Var0 )
	Switch *Var0
		Case == 0`
			Call  SpeakToPlayer ( .Npc:Dark 00E6030B 00E60302 00000000 00080062 ) %Hello I am dark
			Call  SetNpcVar ( .Npc:Dark 0 1 )
		Case == 1`
			Call  SpeakToPlayer ( .Npc:Dark 00E6030B 00E60302 00000000 00080063 ) %That is all
			Call  SetNpcVar ( .Npc:Dark 0 2 )
		Case == 2`
			Call  SpeakToPlayer ( .Npc:Dark 00E6030B 00E60302 00000000 00080063 ) %That is all
			Call  SetNpcVar ( .Npc:Dark 0 3 )
		Case == 3`
			Call  SpeakToPlayer ( .Npc:Dark 00E6030B 00E60302 00000000 00080064 ) %Tell Fatguy and Kappy I'll be late
			Call  SetNpcVar ( .Npc:Dark 0 4 )
		Case == 4`
			Call  SpeakToPlayer ( .Npc:Dark 00E6030B 00E60302 00000000 00080063 ) %That is all
	EndSwitch
	Return
	End
}


#new:Script $Script_Init_IronCleft
{
	Call  SetNpcScale   ( .Npc:Self *Fixed[1.75] *Fixed[1.75] *Fixed[1.75] )
    If *GF_TYD00_IronClefts == .True
        Call    SetNpcPos ( .Npc:Self 0 -1000` 0 )
    EndIf
	Call	BindNpcInteract ( .Npc:Self $Script_Interact_IronClefts )
    Call    BindNpcDefeat ( .Npc:Self $Script_Defeat_IronClefts )
	Return
	End
}

#new:Script $Script_Interact_IronClefts
{
	If  *IronCleftTaunt == .False
		Call	SpeakToPlayer ( .Npc:IronCleftRed 0030021B 00300202 00000000 0008005B )
		Call	SpeakToPlayer ( .Npc:IronCleftGreen 0030031B 00300302 00000000 0008005C )
		Set  *IronCleftTaunt .True
	Else
		Call	SpeakToPlayer ( .Npc:IronCleftRed 0030021B 00300202 00000000 00080060 )
		Call	SpeakToPlayer ( .Npc:IronCleftGreen 0030031B 00300302 00000000 00080061 )
	EndIf
    Call    StartBattleWith ( .Song:RadioIslandSounds )
	Return
	End
}


#new:Script $Script_Defeat_IronClefts
{    
    Call    SetSelfEnemyFlagBits ( 00000004 .True ) % bit2 == Don't make the player and npc sprite start flashing after the fight ends
    Call    GetBattleOutcome ( *Var0 )
    Switch  *Var0
        Case == .Outcome:PlayerWon
			Set  *YoshiCookieIronCleftFlag .False
            Call	SpeakToPlayer ( .Npc:IronCleftRed 0030021B 00300202 00000000 0008008A )
			Call	SpeakToPlayer ( .Npc:IronCleftGreen 0030031B 00300302 00000000 0008008B )
            Call    InterpNpcYaw ( .Npc:Self 90` 0 )
            Wait    15`
			Thread
				Call    SetNpcAnimation ( .Npc:IronCleftRed 00300202 ) % walking
				Call    SetNpcSpeed ( .Npc:IronCleftRed *Fixed[6.0] )
				Call    PlaySoundAtNpc    ( .Npc:IronCleftRed 015E 00000000 ) % run away sfx
				Call    GetNpcPos ( .Npc:IronCleftRed *Var0 *Var1 *Var2 )
				Add     *Var0 200` % x
				Call    NpcMoveTo ( .Npc:IronCleftRed *Var0 *Var2 0 )
				Call    SetNpcPos ( .Npc:IronCleftRed 0 -1000` 0 )
			EndThread
            Call    SetNpcAnimation ( .Npc:IronCleftGreen 00300302 ) % walking
            Call    SetNpcSpeed ( .Npc:IronCleftGreen *Fixed[6.0] )
            Call    PlaySoundAtNpc    ( .Npc:IronCleftGreen 015E 00000000 ) % run away sfx
            Call    GetNpcPos ( .Npc:IronCleftGreen *Var0 *Var1 *Var2 )
            Add     *Var0 200` % x
            Call    NpcMoveTo ( .Npc:IronCleftGreen *Var0 *Var2 0 )
            Call    SetNpcPos ( .Npc:IronCleftGreen 0 -1000` 0 )
            Call    ModifyColliderFlags 	( .False ~Collider:battle 7FFFFE00 )
            Set     *GF_TYD00_IronClefts .True
			Set     *MapFlag[07] .False
        CaseOR == .Outcome:PlayerFled
		CaseOR == .Outcome:PlayerLost
			Set  *MapFlag[07]  .True
			Set  *YoshiCookieIronCleftFlag .False
            Call	SpeakToPlayer ( .Npc:IronCleftRed 0030021B 00300202 00000000 0008005D )
			Call  RandInt ( 1` *Var0 )
			If  *Var0 == 0`
				Call	SpeakToPlayer ( .Npc:IronCleftGreen 0030031B 00300302 00000000 0008005E )
			Else
				Call	SpeakToPlayer ( .Npc:IronCleftGreen 0030031B 00300302 00000000 0008005F )
			EndIf
        EndCaseGroup
    EndSwitch
		Loop 15`
			Call FindItem  ( .Item:YoshiCookieBattle *VarE ) 
			If  *VarE == FFFFFFFF
				BreakLoop
			EndIf
			Call  RemoveItemAt  ( *VarE )
			Wait  1`
			Call AddItem ( .Item:YoshiCookie *Var0 )
		EndLoop
	Call    DisablePlayerInput ( .False )
    Return
    End
}

% Pipes

#new:Script $Script_EnterVerticalPipe
{
	Call  DisablePlayerInput    ( .True )
	Call  DisablePlayerPhysics  ( .True )
	Call  DisablePartnerAI      ( 00000000 )
	Call  HidePlayerShadow      ( .True )
	Call  SetPlayerAnimation    ( .PlayerAnim:StandStill )
	Call  GetCurrentPartnerID   ( *Var0 )
	If  *Var0  !=  .Partner:None % 0
		Call  EnableNpcShadow   ( .Npc:Partner .False )
		Call  SetNpcPos ( .Npc:Partner 00000000 -1000` 00000000 )
	EndIf
	Call  GetEntryID    ( *Var0 )
	Call  $Function_Pipe_GetEntryCoords
	Sub   *Var2  40`
	Call  SetPlayerPos  ( *Var1 *Var2 *Var3 )
	Call  InterpPlayerYaw   ( *Var4 00000000 )
	Call  PlaySound     ( 00000163 )
	Call  802D286C      ( 00000100 )
	Call  802D2520      ( 00010000 00000005 00000002 00000001 00000001 00000000 )
	Call  GetPlayerPos  ( *Var0 *Var1 *Var2 )
	Loop  40`
		Add   *Var1  00000001
		Call  SetPlayerPos  ( *Var0 *Var1 *Var2 )
		Wait  1`
	EndLoop
	Wait  3`
	Call  GetCurrentPartnerID   ( *Var0 )
	If  *Var0  !=  .Partner:None % 0
		Thread
			Call  DisablePartnerAI  ( 00000000 )
			Call  GetPlayerPos      ( *Var0 *Var1 *Var2 )
			Sub   *Var2  00000003
			Call  SetNpcPos ( .Npc:Partner *Var0 *Var1 *Var2 )
			Call  SetNpcFlagBits    ( .Npc:Partner 00000002 .False )
			Call  EnablePartnerAI
			Call  EnableNpcShadow   ( .Npc:Partner .True )
		EndThread
	EndIf
	Wait  2`
	Call  802D2520  ( 00010000 00000000 00000000 00000000 00000000 00000000 )
	Wait  1`
	Call  SetPlayerAnimation    ( 00010002 )
	Call  DisablePlayerPhysics  ( .False )
	Call  DisablePlayerInput    ( .False )
	Call  HidePlayerShadow      ( .False )
	Label  0
	Call  $Function_Pipe_GetCurrentFloor
	Wait  1`
	If  *Var0  !=  FFFFFFFF % FFFFFFFF
		Goto  0
	EndIf
	Exec  *VarA
	Return
	End
}

/%
	ARGS:
	*VarA  entryID
	*VarB  colliderID
	*VarC  $Script_GotoMap
%/
#new:Script $Script_ExitVerticalPipe
{
	Call  $Function_Pipe_CheckDownInput
	If  *Var0  ==  00000000
		Return
	EndIf
	Call  GetCurrentPartner ( *Var0 )
	If  *Var0  !=  .Partner:None
		Call  GetCurrentPartnerID   ( *Var1 )
		If  *Var1  !=  .Partner:Watt % 6
			Return
		Else
			Call  802D2B6C
			Call  DisablePlayerInput    ( .True )
		EndIf
	Else
		Call  DisablePlayerInput    ( .True )
	EndIf
	SetGroup  0000001B
	Call  $Function_Pipe_SetAnimFlag
	Call  DisablePlayerPhysics  ( .True )
	Call  HidePlayerShadow  ( .True )
	Set   *Var0  *VarA
	Call  $Function_Pipe_GetEntryCoords
	Call  PlayerMoveTo      ( *Var1 *Var3 00000003 )
	Set   *Var0  *VarA
	Call  $Function_Pipe_GetEntryCoords
	Call  SetPlayerPos      ( *Var1 *Var2 *Var3 )
	Call  SetPlayerFlagBits ( 00200000 .True )
	Call  $Function_Pipe_GetCameraYaw
	Call  InterpPlayerYaw   ( *Var0 00000000 )
	Wait  2`
	Call  SetPlayerFlagBits ( 00200000 .False )
	Call  PlaySound ( 00000163 )
	Call  GetPlayerPos      ( *Var0 *Var1 *Var2 )
	Thread
		Wait  4`
		Loop  40`
			Sub   *Var1  00000001
			Call  SetPlayerPos  ( *Var0 *Var1 *Var2 )
			Wait  1`
		EndLoop
	EndThread
	Call  802D286C  ( 00000800 )
	Call  802D2520  ( 00010002 00000005 00000002 00000001 00000001 00000000 )
	Wait  25`
	ExecWait  *VarC
	Return
	End
}

% Pipe functions

% Pipe Code

#new:Function $Function_Pipe_SetAnimFlag
{
	LAW       V0, 800F7B30
	LW        V1, 4 (V0)
	LUI       A0, 10
	OR        V1, V1, A0
	SW        V1, 4 (V0)
	JR        RA
	ADDIU     V0, R0, 2
}

#new:Function $Function_Pipe_GetCurrentFloor
{
	LAH       V0, 8015A552
	SW        V0, 84 (A0)
	JR        RA
	ADDIU     V0, R0, 2
}

#new:Function $Function_Pipe_CheckDownInput
{
	LAH       V1, 8015A552
	ADDIU     SP, SP, FFE8
	SW        S0, 10 (SP)
	COPY      S0, A0
	SW        RA, 14 (SP)
	LW        V0, B0 (S0)
	BEQ       V1, V0, .o2C
	ADDIU     V0, R0, 2
	BEQ       R0, R0, .oAC
	SW        R0, 84 (S0)
	.o2C
	LAW       V1, 8007419C
	LB        V0, 40 (V1)
	LB        A3, 44 (V1)
	BLTZL     V0, .o44
	SUBU      V0, R0, V0
	.o44
	BNE       V0, R0, .o54
	NOP
	BEQL      A3, R0, .oAC
	CLEAR     V0
	.o54
	MTC1      V0, F4
	NOP
	CVT.S.W   F4, F4
	MFC1      A2, F4
	MTC1      A3, F4
	NOP
	CVT.S.W   F4, F4
	MTC1      R0, F12
	MFC1      A3, F4
	JAL       ~Func:atan2
	MOV.S     F14, F12
	LIF       F2, 60.0
	NOP
	C.LT.S    F0, F2
	NOP
	BC1F      .oA8
	ADDIU     V0, R0, 1
	SW        V0, 84 (S0)
	BEQ       R0, R0, .oAC
	ADDIU     V0, R0, 2
	.oA8
	CLEAR     V0
	.oAC
	LW        RA, 14 (SP)
	LW        S0, 10 (SP)
	JR        RA
	ADDIU     SP, SP, 18
}

#new:Function $Function_Pipe_GetEntryCoords
{
	ADDIU     SP, SP, FFE0
	SW        S1, 14 (SP)
	COPY      S1, A0
	SW        RA, 1C (SP)
	SW        S2, 18 (SP)
	JAL       ~Func:get_current_map_header
	SW        S0, 10 (SP)
	COPY      A0, S1
	LIO       A1, *Var0
	JAL       ~Func:get_variable
	COPY      S2, V0
	COPY      A0, S1
	LUI       A1, FE36
	LW        V1, 14 (S2)
	SLL       S0, V0, 4
	ADDU      V1, S0, V1
	LWC1      F0, 0 (V1)
	TRUNC.W.S F2, F0
	MFC1      A2, F2
	JAL       ~Func:set_variable
	ORI       A1, A1, 3C81 % Var1
	COPY      A0, S1
	LW        V0, 14 (S2)
	LUI       A1, FE36
	ADDU      V0, S0, V0
	LWC1      F0, 4 (V0)
	TRUNC.W.S F2, F0
	MFC1      A2, F2
	JAL       ~Func:set_variable
	ORI       A1, A1, 3C82 % Var2
	COPY      A0, S1
	LW        V0, 14 (S2)
	LUI       A1, FE36
	ADDU      V0, S0, V0
	LWC1      F0, 8 (V0)
	TRUNC.W.S F2, F0
	MFC1      A2, F2
	JAL       ~Func:set_variable
	ORI       A1, A1, 3C83 % Var3
	COPY      A0, S1
	LW        V0, 14 (S2)
	LUI       A1, FE36
	ADDU      S0, S0, V0
	LWC1      F0, C (S0)
	TRUNC.W.S F2, F0
	MFC1      A2, F2
	JAL       ~Func:set_variable
	ORI       A1, A1, 3C84 % Var4
	LW        RA, 1C (SP)
	LW        S2, 18 (SP)
	LW        S1, 14 (SP)
	LW        S0, 10 (SP)
	ADDIU     V0, R0, 2
	JR        RA
	ADDIU     SP, SP, 20
}

#new:Function $Function_Pipe_GetCameraYaw
{
	LAW       V1, 80077410
	LIF       F12, 180.0
	ADDIU     SP, SP, FFE8
	SW        RA, 14 (SP)
	SW        S0, 10 (SP)
	SLL       V0, V1, 2
	ADDU      V0, V0, V1
	SLL       V0, V0, 2
	SUBU      V0, V0, V1
	SLL       V1, V0, 3
	ADDU      V0, V0, V1
	SLL       V0, V0, 3
	LTF       F0, V0 (800B1DEC)
	ADD.S     F12, F0, F12
	JAL       ~Func:clamp_angle
	COPY      S0, A0
	TRUNC.W.S F2, F0
	SWC1      F2, 84 (S0)
	LW        RA, 14 (SP)
	LW        S0, 10 (SP)
	ADDIU     V0, R0, 2
	JR        RA
	ADDIU     SP, SP, 18
}

#new:Function $Function_Pipe_GetPointInFrontOfPlayer
{
	ADDIU     SP, SP, FFD8
	SW        S0, 18 (SP)
	COPY      S0, A0
	SW        RA, 1C (SP)
	SDC1      F20, 20 (SP)
	LW        V0, C (S0)
	JAL       ~Func:get_float_variable
	LW        A1, 0 (V0)
	ADDIU     A0, SP, 10
	LIA       V0, 8010EFC8
	MFC1      A2, F0
	LWC1      F0, 28 (V0) % player X
	LWC1      F2, 30 (V0) % player Z
	SWC1      F0, 10 (SP) % arg0 for add_vec2D_polar
	SWC1      F2, 14 (SP) % arg1 for add_vec2D_polar
	LW        A3, 80 (V0)
	LWC1      F20, 2C (V0)
	JAL       ~Func:add_vec2D_polar
	ADDIU     A1, SP, 14
	COPY      A0, S0
	LUI       A1, FE36
	LW        A2, 10 (SP)
	JAL       ~Func:set_float_variable
	ORI       A1, A1, 3C80 % Var0
	COPY      A0, S0
	LUI       A1, FE36
	MFC1      A2, F20
	JAL       ~Func:set_float_variable
	ORI       A1, A1, 3C81 % Var1
	COPY      A0, S0
	LUI       A1, FE36
	LW        A2, 14 (SP)
	JAL       ~Func:set_float_variable
	ORI       A1, A1, 3C82 % Var2
	LW        RA, 1C (SP)
	LW        S0, 18 (SP)
	LDC1      F20, 20 (SP)
	ADDIU     V0, R0, 2
	JR        RA
	ADDIU     SP, SP, 28
}

% Panners

#new:Script $Script_SetupTexturePan
{
	Call     802C9000 	( ~Model:water 0 )
	Thread
		Set  *Var[0] 0
		Set  *Var[1] 0
		Set  *Var[2] 0
		Set  *Var[3] 0
		Set  *Var[4] FFFFFF88
		Set  *Var[5] 0
		Set  *Var[6] 0
		Set  *Var[7] 1
		Set  *Var[8] 0
		Set  *Var[9] 0
		Set  *Var[A] 0
		Set  *Var[B] 0
		Set  *Var[C] 0
		Exec $Script_TexturePan_Update
	EndThread
	Return
	End
}

#new:Script $Script_TexturePan_Update
{
    SetGroup  00000000
    If  *Var[5]  ==  00000001
        If  *Var[6]  ==  00000001
            If  *Var[7]  ==  00000001
                If  *Var[8]  ==  00000001
                    Call  $Function_TexturePan_Simple ( )
                    Return
                EndIf
            EndIf
        EndIf
    EndIf
    Call  $Function_TexturePan_Complex ( )
    Return
    End
}

