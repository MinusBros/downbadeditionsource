  308:  		EndThread
  310:  		Set   *Var3  000001F4
  320:  		Exec  $Script_80240570 *VarA
  330:  		Call  SetPlayerJumpscale    ( *Fixed[0.7] )
  340:  		Call  PlayerJump    ( ~Vec3d:JumpDest_8024096C  20` )
  35C:  		Set   *AreaFlag[003]  .False
