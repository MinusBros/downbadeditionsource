@	$AISettings_802418AC
{
    2.0 % move speed
    180` % move time
    20` % wait time
  150.0 % alert radius
   40.0
    10`
    7.5 % chase speed
    90`
    15`
  250.0 % chase radius
  160.0
    1`
}


@	$NpcGroupList_8024318C
{
	00000002 $NpcGroup_80241A4C 0F030003
	00000002 $NpcGroup_80241E2C 0F000003
	00000002 $NpcGroup_8024220C 0F000003
	00000002 $NpcGroup_802425EC 0F000003
	00000002 $NpcGroup_802429CC 0F010003
	00000002 $NpcGroup_80242DAC 0F010003
	1 $Luigi 0 0
	00000000 00000000 00000000
}




#define .Npc:Luigi  20



#new:NpcGroup  $Luigi
{
	.Npc:Luigi $LuigiSettings ~Vec3f:Luigi
	00002009 $Script_Init_Luigi 0` 0` 90`
	~NoDrops
	~Movement:Luigi
	~AnimationTable:Luigi
	0` 0` 0` $LuigiTattle
}


#new:Script  $Script_Init_Luigi
{
	If  *GF_DGB16_Item_CastleKey1 == .True
		Call  RemoveNpc ( .Npc:Self )
	EndIf
	Call  BindNpcInteract   ( .Npc:Self $Script_Interact_Luigi )
	Return
	End
}


#new:Script $Script_Interact_Luigi
{
		Call  SpeakToPlayer ( .Npc:Self 00820017 00820007 00000000 $LuigiInteract )
		Return
		End
}


#new:NpcSettings $LuigiSettings
{
	00000000 00230018 00000000 00000000 0 00000000 00000000 00000000
	00000000 00000000 00630010
}





#new:AISettings $LuigiAISettings {
    1.5 % move speed
    60` % move time
    30` % wait time
    0.0 % alert radius
    0.0
    -1`
    0.0 % chase speed
    0`
    0`
    0.0 % chase radius
    0.0
    1`
}

#new:Script $Script_Luigi_Move {
    0:  Call  DoBasicAI ( $LuigiAISettings )
   10:  Return
   18:  End
}



#string $LuigiInteract
{
[Style Right]
Oh, hey, Bro![BR]
What are you doing out here?[BR]
[Pause 10][DitherFade percent=80]Shhhhh. Be very, very quiet.[BR]
I'm hunting Clubbas.[BR]
[Wait][Next]
Clubba-hunting is a popular fad[BR]
right now, don't ya know?[BR]
[Pause 10]Yahoo, indeedy.[BR]
A Toad in the area told me.[BR]
[Wait][Next]
He said I could borrow his bazooka,[BR]
but I'm-a no gunslinger, Mario.[BR]
[Pause 10]I stomp Goombas and-a Koopas on[BR]
a regular basis.[BR]
[Wait][Next]
I mean I GUESS I carried a gun[BR]
that one time when those weird[BR]
rabbit ragazzos came along.[BR]
[Pause 10]We don't talk about that.[BR]
[Wait][Next]
I mean it.[BR]
[Wait][End]
}


#string $LuigiTattle
{
[Style Tattle]
[EnableCDownNext]
So Luigi's hunting Clubbas, huh?[BR]
Why not go straight for the big[BR]
man himself, Tubbs?[BR]
[Wait][Next]
Actually he's probably too much[BR]
of a shrimp to do that all by[BR]
himself.[BR]
[Wait][Next]
Leave it old Goombarius.[BR]
Tubbs is gonna frickin' die[BR]
tonight. Haha yeah![BR]
[Wait][Next]
We can leave Luigi to do his[BR]
wimpy hunting.[BR]
[Wait][End]
}