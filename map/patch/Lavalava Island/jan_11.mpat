#new:Script $Script_80240AF4
{
		If  *BigLanternGhostCompleted == .True
   18:  	Set   *AreaByte[1]  00000005
   28:  	Set   *AreaByte[2]  0000007F
   38:  	Exec  $Script_SetupLightSource
		Else
		EndIf
   9C:  Return
