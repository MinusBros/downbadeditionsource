@	$Script_Main_EnterWalk
{
    0:  Set   *GB_WorldLocation  .Location:JadeJungle
   10:  Call  SetSpriteShading  ( .Shading:tik_01 )
   20:  Call  SetCamPerspective ( .Cam:Default 00000003  25`  16`  4096` )
   40:  Call  SetCamBGColor     ( .Cam:Default  0`  0`  0` )
   5C:  Call  SetCamLeadPlayer  ( .Cam:Default .False )
   70:  Call  SetCamEnabled     ( .Cam:Default .True )
		If  *GB_StoryProgress  >=  .Story:Ch5_KoloradoRanAhead
			Call  MakeNpcs  ( .False $NpcGroupList_BLG )
		Else
			Call  MakeNpcs  ( .False $NpcGroupList_80242820 )
		EndIf
   98:  Exec  $Script_80240890
   A4:  Set   *Var0  $Script_80241F38
   B4:  Exec  EnterWalk
   C0:  Exec  $Script_80240850
   CC:  ExecWait  $Script_80241E84
   D8:  Return
   E0:  End
}

