#new:Script  $Script_Init_BigLanternGhost
{
	Call  BindNpcIdle   ( .Npc:Self $Script_Idle_BLG )
	Call  BindNpcInteract   ( .Npc:Self $Script_Interact_BLG )
			If  *BigLanternGhostCompleted == .False
				Exec  $BigLanternGhostProblem
			EndIf
	Return
	End
}


#new:Script  $BigLanternGhostProblem
{
		Wait  10`
		Loop
			Call  ShowEmote ( .Npc:BigLanternGhost .Emote:Frustration  1`  60` .True  0`  0`  0`  0` )
			Wait  60`
			If  *BigLanternGhostCompleted == .True
				BreakLoop
			EndIf
		EndLoop
		Return
		End
}

#new:Script $Script_Idle_BLG
{
		Label  0
		Wait  1`
		Call  GetPlayerPos  ( *Var0 *Var1 *Var2 )
		Call  GetCurrentPartnerID   ( *Var3 )
		If  *Var0 < 215`
			Goto  0
		EndIf
		If  *Var3 != .Partner:Watt
			Goto  0
		EndIf
		Call  DisablePlayerInput    ( .True )
		ExecWait $Script_Interact_BLG
		Call  GetPlayerPos  ( *Var0 *Var1 *Var2 )
		Call  SetPlayerPos  ( 214` *Var1 *Var2 )
		Wait  1`
		Call  DisablePlayerInput    ( .False )		
		Goto  0
   70:  Return
   78:  End
}

#new:Script  $Script_Interact_BLG
{
		If  *BigLanternGhostCompleted == .True
			Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 0010016D )	
			Return
		EndIf
		Call  PushSong  ( .Song:CreepyToybox 00000000 )
		Wait  8`
		If  *BigLanternGhostAsked == .False
			Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 00100167 )	
			Wait  20`
			Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 00100168 )	
			Set  *BigLanternGhostAsked .True
			If  *LampOilObtained == .True
				Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 0010016A )
			EndIf
			ExecWait  $Script_CompletedBLG
			If  *MapFlag[02] == .True
				Goto BLGEnding
			EndIf
			Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 00100169 )	
		Else
			If  *LampOilObtained == .True
				Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 0010016A )
			Else
				Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 00100169 )
			EndIf	
		EndIf
		
		ExecWait  $Script_CompletedBLG
		Label  BLGEnding
		Wait  5`
		Call PopSong ( )
		Return
		End
}

#new:Script  $Script_CompletedBLG
{
		If  *BigLanternGhostCompleted == .False
				Call  FindKeyItem   ( .Item:LampOil *Var1 )
				If    *Var1 != FFFFFFFF
					Set   *Var0  $???_CheckLampOil
					Set   *Var1  00000005
					ExecWait $Script_CheckForKeyItem	
					Switch *Var0
						Case   == 0`   %If you don't have the key item, end script
							Return
						Case   == FFFFFFFF  %If you refuse to give the key item, say a funny line
							Set  *MapFlag[02] .True
							%Call  SpeakToPlayer ( 00000001 00BF0007 00BF0008 00000000 000E0139  )
						Default			%If you give him the key item
							Set  *MapFlag[02] .True
							Set  *BigLanternGhostCompleted .True
							Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 0010016B )	
							Loop  2`
					   10:  	Set   *Var0  0000015C
					   20:  	Set   *Var1  00000003
					  108:  	Call  ShowGotItem   ( *Var0 .True 00000000 )
					  114:  	Call  AddStarPieces ( 00000001 )
								Wait  1`
							EndLoop
							Call  $Function_CountItems
							If *Var0 != .False
								Call  ShowGotItem       ( .Item:ElectroPop .True 00000000 )
								Call  AddItem   ( .Item:ElectroPop 0 )
							EndIf
							Call  SpeakToPlayer ( .Npc:Self 006D0005 006D0001 00000000 0010016C )	
							ExecWait  $ProblemSolved
					  10C:  Call  GetNpcPos     ( .Npc:BigLanternGhost *Var2 *Var3 *Var4 )
					  128:  Add   *Var2  00000020
					  138:  Add   *Var3  0000000A
					  148:  Call  MakeLerp      ( 000000FF 00000064 0000003C .Easing:Linear )
					  164:  Label  0
					  170:  Call  UpdateLerp ( )
					  17C:  Call  $Function_HandleLight    ( *Var2 *Var3 *Var4 *Var0 )
					  198:  Wait  1`
					  1A4:  If  *Var1  ==  00000001
					  1B4:  	Goto  0
					  1C0:  EndIf
							Exec  $Script_SetupLightSource
							Return
					EndSwitch
				EndIf
		EndIf
		Return
		End
}


