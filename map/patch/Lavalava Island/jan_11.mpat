#new:Script $Script_SetupLightSource
{
    0:  SetGroup  00000000
    C:  Label  0
   18:  Switch  *AreaByte[1]
   30:  	Case  ==  00000001
   3C:  		Call  GetNpcPos ( .Npc:BigLanternGhost *Var0 *Var1 *Var2 )
   58:  		Set   *Var3  *AreaByte[2]
   68:  		Add   *Var3  00000080
   78:  		Call  $Function_HandleLight    ( *Var0 *Var1 *Var2 *Var3 )
  1DC:  	Case  ==  00000006
  1E8:  		Return
  1F0:  EndSwitch
  1F8:  Wait  1`
  204:  Goto  0
  210:  Return
  218:  End
}


