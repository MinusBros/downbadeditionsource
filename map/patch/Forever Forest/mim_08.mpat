@	$Script_Main_EnterWalk
{
   [10]  Call  SetSpriteShading  ( .Shading:mim_01 )
}


@	$Script_MakeEntities
{
    Call  MakeEntity        ( .Entity:Chest ~Vec4d:Entity802434F0 00000000 80000000 )
    Call  AssignFlag        ( *GF_MIM08_BadgeBlock_HPPlusA )
	Call  AssignScript      ( $Script_OpenChest )
	Return
	End
}

#new:Script $Script_OpenChest
{
   20:  Set   *GF_MIM08_BadgeBlock_HPPlusA  .True
   30:  ExecWait  $Script_GiveItem
   3C:  Return
   44:  End
}

#new:Script $Script_GiveItem
{
    0:  Call  DisablePlayerInput    ( .True )
		Wait  30`
				Set   *Var0  1BC
				Set   *Var1  2
				Call  ShowGotItem   ( *Var0 .True 00000000 )
				If  *HavePieceofHeart == .False
					Set  *HavePieceofHeart .True
					Call  AddBadge  ( .Item:PieceOfHeart *Var0 )
				EndIf
				Add *PiecesofHeart 1`
				If  *PiecesofHeart > 1`
					Call  SetMessageValue   ( *PiecesofHeart 5 )
					Call  ShowMessageAtScreenPos    ( 001F00E9  160`  40` ) %You now have X pieces of heart
				EndIf
   C0:  Call  DisablePlayerInput    ( .False )
   D0:  Return
   D8:  End
}