		Call  SetMusicTrack ( 00000000 .Song:RuinsBasement 00000002 00000008 )
		Wait  1`
  118:  Call  StartBossBattle   ( .Song:SpecialBattle )
		Wait  1`
		Exec $Script_Defeat_80242014
  114:  Return
  11C:  End
}

