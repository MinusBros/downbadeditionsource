#new:Script $Script_Defeat_Generic
{
	Call  GetBattleOutcome  ( *Var0 )
	Switch  *Var0
		Case  ==  .Outcome:PlayerWon % 0
		Case  ==  .Outcome:PlayerLost
			Call $ClearFlagCarryOverworldMusicToBattle()
			%Call  802C022C  ( 1` )	%Put player at 1 HP
			Call  GotoMap   ( "pra_16" 1 ) % pra_16			
			Wait  100`
			Return
	EndSwitch
	Return
	End
}

