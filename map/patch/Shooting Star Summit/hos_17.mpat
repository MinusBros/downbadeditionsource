#new:Script_Main $Script_Main
{
	Set   *GB_WorldLocation  .Location:ShootingStarSummit
	Call  SetSpriteShading   ( .Shading:hos_01 )
	Call  MakeNpcs  ( .False $NpcGroupList_LoveHotel )
	Call  SetCamPerspective  ( .Cam:Default 00000003  25`  16`  650` )
	Call  SetCamBGColor      ( .Cam:Default 00000005 00000000 00000005 )
	Call  SetCamEnabled      ( .Cam:Default .True )
	Call  SetCamLeadPlayer   ( .Cam:Default .False )
	Exec  $Script_SetupMusic
	Exec  $Script_SetupTexturePan
	Call  $Function_SetupFog
	Set   *Var0  $Script_CreateExitTriggers 	
	Exec  EnterWalk
	Return
	End
}





#new:Script $Script_Init_Toad
{
    0:  Call  BindNpcInteract   ( .Npc:Self $Script_Interact_Toad )
   68:  Return
   70:  End
}

#new:Script  $Script_Interact_Toad
{
		Switch  *GB_StoryProgress
			Case  <  .Story:Ch2_StarSpritDeparted
				Set   *Var0  $PurpleToad1
			Case  <  .Story:Ch6_StarSpiritRescued
				Set   *Var0  $PurpleToad2
		Case  >=  .Story:Ch6_StarSpiritRescued
				Set   *Var0  $PurpleToad3
		EndSwitch
		Call  SpeakToPlayer ( .Npc:Self 00830604 00830601 00000000 *Var0 ) % variable string ID
		Return
		End
}







#new:Script $Script_Init_BubUlb
