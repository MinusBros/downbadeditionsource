			Call  RemoveNpc ( .Npc:Self )
		EndIf
    0:  Call  BindNpcInteract   ( .Npc:Self $Script_Interact_BubUlb )
   68:  Return
   70:  End
}

#new:Script  $Script_Interact_BubUlb
