}

%We're gonna add a new block and have it update based on story progression

@	$Script_MakeEntities
{
    0:  Call  MakeEntity        ( .Entity:HiddenPanel ~Vec4d:Entity80244FE0 ~Model:o210 80000000 )
   28:  Call  AssignPanelFlag   ( *GF_HOS01_HiddenPanel )
   38:  Call  MakeItemEntity    ( .Item:StarPiece ~Vec3d:Item80245018 .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_Item_StarPiece )
		Switch  *GB_StoryProgress
			Case  <  .Story:Ch1_ReturnedToToadTown
				Call  MakeEntity    ( .Entity:YellowBlock ~Vec4d:NewBlock .Item:HoneySyrup 80000000 )
			Case  <  .Story:Ch5_ReturnedToToadTown
				Call  MakeEntity    ( .Entity:YellowBlock ~Vec4d:NewBlock .Item:MapleSyrup 80000000 )
		Case  >=  .Story:Ch5_ReturnedToToadTown
				Call  MakeEntity    ( .Entity:YellowBlock ~Vec4d:NewBlock .Item:JamminJelly 80000000 )
		EndSwitch	
		Call     AssignBlockFlag 	( *GF_HOS01_NewBlock )	
		Call  MakeItemEntity    ( .Item:StarPoint ~Vec3d:StarPointA .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_StarPointA )
		Call  MakeItemEntity    ( .Item:StarPoint ~Vec3d:StarPointB .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_StarPointB )
		Call  MakeItemEntity    ( .Item:StarPoint ~Vec3d:StarPointC .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_StarPointC )
		Call  MakeItemEntity    ( .Item:StarPoint ~Vec3d:StarPointD .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_StarPointD )
		Call  MakeItemEntity    ( .Item:StarPoint ~Vec3d:StarPointE .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_StarPointE )
		Call  MakeItemEntity    ( .Item:StarPoint ~Vec3d:StarPointF .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_StarPointF )
		Call  MakeItemEntity    ( .Item:StarPoint ~Vec3d:StarPointG .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_StarPointG )
		Call  MakeItemEntity    ( .Item:StarPoint ~Vec3d:StarPointH .ItemSpawnMode:Fixed_NeverVanish *GF_HOS01_StarPointH )
   5C:  Return
   64:  End
}



