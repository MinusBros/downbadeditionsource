{
   [84]  Wait  10`
  [184]  Wait  5`
  [1A8]  Call  SetMusicTrack ( 00000000 .Song:MarioFalls 00000000 00000008 )
  [1C4]  Wait  5`
  [3B4]  Wait  30`
  [49C]  Wait  6`
}


