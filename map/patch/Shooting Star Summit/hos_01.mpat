%Change music for going into Star Way.

#define .NpcID:WorldEldstar_00      00
#define .NpcID:WorldMamar_01        01
#define .NpcID:WorldSkolar_02       02
#define .NpcID:WorldMuskular_03     03
#define .NpcID:WorldMisstar_04      04
#define .NpcID:WorldKlevar_05       05
#define .NpcID:WorldKalmar_06       06

@	$EntryList
{
	~Vec4f:Entry0 % -400.0    0.0  410.0   45.0
	~Vec4f:Entry1 %   22.0  285.0 -190.0    0.0
	~Vec4f:Entry2
}

@ $Header
{
	[MainScript]  $Script_Main_EnterWalk
	[EntryList]   $EntryList
	[EntryCount]  3
	[Background]  80200000
	[MapTattle]   0019001D
}

@	$Script_Main_EnterWalk
{
    0:  Set   *GB_WorldLocation  .Location:ShootingStarSummit
   10:  Call  SetSpriteShading  ( .Shading:hos_01 )
   20:  Call  SetCamPerspective ( .Cam:Default 00000003  25`  16`  4096` )
   40:  Call  SetCamBGColor     ( .Cam:Default  0`  0`  0` )
   5C:  Call  SetCamEnabled     ( .Cam:Default .True )
   70:  Call  SetCamLeadPlayer  ( .Cam:Default .False )
   84:  Thread
   8C:  	Label  1
   98:  	If  *GB_StoryProgress  !=  .Story:Ch0_MetStarSpirits % FFFFFF96
   A8:  		Wait  1`
   B4:  		Goto  1
   C0:  	EndIf
   C8:  	Call  DisablePlayerInput    ( .True )
   D8:  	ExecWait  $Script_ExitWalk_80241384
   E4:  EndThread
  100:  ExecWait  $Script_MakeEntities
  10C:  Exec  $Script_80241D48
  118:  Exec  $Script_8024121C
  124:  Exec  $Script_80240E80
  130:  Call  GetEntryID    ( *Var0 )
  140:  Switch  *Var0
  14C:  	Case  ==  ~Entry:Entry0
				Call  MakeNpcs      ( .False $NpcGroupList_80244FC0 )
  158:  		Set   *Var0  $Script_80241540
  168:  		Exec  EnterWalk
  174:  		Wait  1`
  180:  	Case  ==  ~Entry:Entry1
				Call  MakeNpcs      ( .False $NpcGroupList_80244FC0 )
  18C:  		Thread
  194:  			ExecWait  $Script_802415B0
  1A0:  			Exec  $Script_80241540
  1AC:  		EndThread
			Case  ==  ~Entry:Entry2
				Set   *Var0  $Script_80241540
				Exec  $PrologueCutsceneSecondHalf
  1B4:  EndSwitch
  1BC:  If  *GB_StoryProgress  ==  .Story:Ch7_StarSpritDeparted % 59
  1CC:  	Exec  $Script_80245050
  1D8:  EndIf
  1E0:  Return
  1E8:  End
}

