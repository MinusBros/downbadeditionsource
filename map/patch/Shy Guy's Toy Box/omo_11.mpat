@	$Script_Main_EnterWalk
{
    0:  Set   *GB_WorldLocation  .Location:ShyGuysToybox
   10:  Call  SetSpriteShading  ( .Shading:None )
   20:  Call  SetCamPerspective ( .Cam:Default 00000003  25`  16`  4096` )
   40:  Call  SetCamBGColor     ( .Cam:Default  0`  0`  0` )
   5C:  Call  SetCamEnabled     ( .Cam:Default .True )
   70:  Call  MakeNpcs  ( .True $NpcGroupList_80242AAC )
   84:  ExecWait  $Script_MakeEntities
   90:  ExecWait  $Script_80241530
   9C:  ExecWait  $Script_80241BF8
   A8:  Set   *Var0  $Script_80241618
   B8:  Exec  EnterWalk
   C4:  Wait  1`
		Switch  *GB_StoryProgress
			Case  <   .Story:Ch4_OpenedGeneralGuyRoom
				Exec  $CheckPos
		EndSwitch
   D0:  Return
   D8:  End
}

@	$Script_80241618
{
    0:  Bind  $Script_ExitWalk_80241560 .Trigger:FloorAbove ~Collider:deili1 00000001 00000000
   1C:  Bind  $Script_ExitWalk_802415BC .Trigger:FloorAbove ~Collider:deili2 00000001 00000000
		Bind  $TrollDeath  .Trigger:FloorAbove ~Collider:trolltrigger 1 0
   38:  Return
   40:  End
}

#new:Script  $TrollDeath
{
		Call  DisablePlayerInput    ( .True )
		Call  GetModelCenter    ( ~Model:o896new )
		Loop  5`
			Sub  *Var7  14`
			Thread
				Call  TranslateModel    ( ~Model:o897new 00000000 *Var7 00000000 )
			EndThread
			Call  TranslateModel    ( ~Model:o896new 00000000 *Var7 00000000 )
			Wait  1`
		EndLoop
  3DC:  	Call  GetModelCenter    ( ~Model:o896new )
  3EC:  	Call  PlayEffect        ( ~FX:Steam:LargeOutward *Var0 0` *Var2 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
		Call  FadeOutMusic  ( 00000000 000000F8 )
		Call  PlaySound ( 57 )
		Call  ShakeCam  ( .Cam:Default 00000000  5` *Fixed[0.4] )
		Wait  80`
		Call  GotoMap   ( "gv_01" 00000000 )
		Wait  80`
		Return
		End
}


#new:Script  $CheckPos
{
	Loop
		Call  GetPlayerPos  ( *Var0 *Var1 *Var2 )
		If  *Var0 < -553`
			Exec $AutoSave
			BreakLoop
		EndIf
		Wait 1`
	EndLoop
	Return
	End
}