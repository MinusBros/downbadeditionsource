%Make the shop always accessible. And give inflation haha

@	$Script_80241670
{
		Call  ModifyColliderFlags   ( 00000000 ~Collider:dummy 7FFFFE00 )
		Switch *GB_StoryProgress
			Case  <  .Story:Ch3_StarSpiritRescued
				Call  MakeShop      ( $ShopItemPositions_802415E8 $ShopInventory_8024154C $ShopPriceList_802415A0 00000000 )
			Case  <  .Story:Ch4_StarSpritDeparted
				Call  MakeShop      ( $ShopItemPositions_802415E8 $ShopInventory_Ch4 $ShopPriceList_802415A0 00000000 )
			Case  <  .Story:Ch5_StarSpritDeparted
				Call  MakeShop      ( $ShopItemPositions_802415E8 $ShopInventory_Ch5 $ShopPriceList_802415A0 00000000 )
			Case  <  .Story:Ch6_StarSpiritRescued
				Call  MakeShop      ( $ShopItemPositions_802415E8 $ShopInventory_Ch6 $ShopPriceList_802415A0 00000000 )
			Case  <  .Story:Ch7_StarSpritDeparted
				Call  MakeShop      ( $ShopItemPositions_802415E8 $ShopInventory_Ch7 $ShopPriceList_802415A0 00000000 )
			Case  <  .Story:PostGame
				Call  MakeShop      ( $ShopItemPositions_802415E8 $ShopInventory_Ch8 $ShopPriceList_802415A0 00000000 )
			Case  >= .Story:PostGame
				Call  MakeShop      ( $ShopItemPositions_802415E8 $ShopInventory_PostGame $ShopPriceList_802415A0 00000000 )
		EndSwitch
   E4:  Call  MakeShopOwner ( $ShopOwnerNPC_80241654 )
   F4:  Return
   FC:  End
}

