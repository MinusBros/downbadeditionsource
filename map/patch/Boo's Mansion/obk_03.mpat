%Reverse the shop interact
%Bow's sidequest takes priority
@	$Script_Interact_80243894
{
		If  *GB_StoryProgress >= .Story:Ch3_BowJoinedParty
			If  *SebastianGotEyeDrops == .False
				Call  GetCurrentPartnerID   ( *Var0 )
				If  *Var0 == .Partner:Bow
					Call  SpeakToPlayer ( .Npc:Self 00950304 00950301 00000000 000E0133 )
					Call  DisablePartnerAI  ( 00000000 )
					Call  SpeakToPlayer ( .Npc:Partner 00010008 00010001 00000005 000E0134 )
					Call  SpeakToPlayer ( .Npc:Self 0095030A 00950313 00000000 000E0135 )
					Call  EndSpeech     ( .Npc:Self 00950304 00950301 00000005 )
					Call  SetNpcFlagBits    ( .Npc:Self 00000100 .True )
					Call  NpcMoveTo     ( .Npc:Self -205` -9`  30` )
					Call  SpeakToPlayer ( .Npc:Partner 00010009 00010001 00000005 000E0136 )
					Call  NpcMoveTo     ( .Npc:Self 43` -9`  30` )
					Call  SpeakToPlayer ( .Npc:Self 00950304 00950301 00000000 000E0137 )
					Call  SetNpcFlagBits    ( .Npc:Self 00000100 .False )
					Thread
						Call  SetNpcAnimation   ( .Npc:Self 0095030B )
						Wait  15`
						Call  SetNpcAnimation   ( .Npc:Self 00950301 )
					EndThread
					Set   *Var0  000001B3  %EyeDrops
					Set   *Var1  00000004
					Call  ShowGotItem   ( *Var0 .True 00000000 )
					Call  AddKeyItem    ( *Var0 )
					Call  InterpPlayerYaw       (  90`  5` )
					Wait  15`
					Call  SpeakToPlayer ( .Npc:Partner 00010008 00010001 00000000 000E0138 )
					Call  EndSpeech     ( .Npc:Partner 0001000A 00010001 00000000 )
					Set  *SebastianGotEyeDrops .True
					Call  EnablePartnerAI ( )
					Return
				EndIf
			EndIf
		EndIf
   4C:  ExecWait  $Script_802437E0
   58:  ExecWait  $Script_80243830
   64:  If  *VarC  !=  00000000
			ExecWait  ItemShopInteract
   74:  	Return
   7C:  EndIf
		ExecWait  ItemShopInteract
   84:  Return
   8C:  End
}


