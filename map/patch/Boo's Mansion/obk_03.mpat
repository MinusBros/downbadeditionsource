#new:Script $ShopCheck
{
		Thread
   80:  If  *Var0  !=  00000000
   90:  	Goto  14
   9C:  EndIf
   A4:  Label  A
   B0:  Wait  2`
   BC:  Call  GetPlayerPos  ( *Var1 *Var2 *Var3 )
   D4:  If  *Var2  <  -185`
			If *Var1 < 270`
				If *ShopState == 00000000
					Set *ShopState 00000001
					Call  PushSong      ( 000000C7 00000000 )
	  120:  		Wait  2`
	  12C:  		Goto  14
				EndIf
			EndIf
  138:  EndIf
  140:  Goto  A
  14C:  Label  14
  158:  Wait  2`
  188:  Call  GetPlayerPos  ( *Var1 *Var2 *Var3 )
  1A0:  If  *Var2  >  -115`
			If *ShopState == 00000001
				Set *ShopState 00000000
				Call  PopSong ( )
			EndIf
  1DC:  	Wait  2`
  1E8:  	Goto  A
		Else
			If  *Var1  >  350`
				If *ShopState == 00000001
					Set *ShopState 00000000
					Call  PopSong ( )
				EndIf
	  1DC:  	Wait  2`
	  1E8:  	Goto  A
		EndIf
		EndIf
  1FC:  Goto  14
		EndThread
		Return
		End
}


