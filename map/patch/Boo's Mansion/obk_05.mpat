@	$Script_80240C84
{
   [68]  		Call  SetMusicTrack     ( 00000000 .Song:MarioBrosHouse 00000000 00000008 )
}

@	$Script_Main
{
   [10]  Call  SetSpriteShading  ( .Shading:kzn_05 )
}

%What if we added all the apples from Super Paper Mario?

@	$Script_MakeEntities
{
    0:  If  *GF_OBK05_BoardedFloor  ==  .False
   10:  	Call  MakeEntity    ( .Entity:BoardedFloor ~Vec4d:Entity80241530 80000000 )
   34:  	Call  AssignScript  ( $Script_80241500 )
   44:  EndIf
		Call  RandInt  ( 12` *VarE )
		Switch  *VarE
			Case   <  2`	% 0 or 1
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity8024156C .Item:Apple 80000000 )	%Granny Apple, but too lazy to change the name
			Case   <  4`	% 2 or 3
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity8024156C .Item:RedApple 80000000 )	%This is actually the vanilla apple
			Case   <  6`	
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity8024156C .Item:OrangeApple 80000000 )
			Case   <  8`
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity8024156C .Item:BlueApple 80000000 )
			Case   < 10`
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity8024156C .Item:PinkApple 80000000 )
			Case   < 12`
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity8024156C .Item:BlackApple 80000000 )
			Case  == 12`
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity8024156C .Item:GoldenApple 80000000 )	%This one is rarer than the others
		EndSwitch		
   74:  Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity80241594 FFFFFFFF 80000000 )
		Call  RandInt  ( 12` *VarE )
		Switch  *VarE
			Case   <  2`	% 0 or 1
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity802415BC .Item:Apple 80000000 )	%Granny Apple, but too lazy to change the name
			Case   <  4`	% 2 or 3
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity802415BC .Item:RedApple 80000000 )	%This is actually the vanilla apple
			Case   <  6`	
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity802415BC .Item:OrangeApple 80000000 )
			Case   <  8`
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity802415BC .Item:BlueApple 80000000 )
			Case   < 10`
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity802415BC .Item:PinkApple 80000000 )
			Case   < 12`
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity802415BC .Item:BlackApple 80000000 )
			Case  == 12`
				Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity802415BC .Item:GoldenApple 80000000 )	%This one is rarer than the others
		EndSwitch	
   C4:  Call  MakeEntity    ( .Entity:WoodenCrate ~Vec4d:Entity802415E4 FFFFFFFF 80000000 )
   EC:  Return
   F4:  End
}