   B0:  	Wait  20`
			ExecWait  $PacManScene
			If  *MapFlag[01] == .False
				ExecWait  $Script_8024224C		%Close cabinet
			EndIf
   C8:  	Call  DisablePlayerInput    ( .False )
   D8:  EndIf
   E0:  Return
   E8:  End
}

%Pac-Man from Pac-Man 2: The New Adventures is a superboss
#new:Script $PacManScene
{
		If  *TheodoreAsked == .True
			If  *PacManDefeated == .True	%Don't spawn Pac-Man if he's been defeated already
				Return
			EndIf
		Else
			Return	%If you didn't talk to Theo
		EndIf
		Set  *MapFlag[02] .True
		Call  SetNpcAnimation   ( .Npc:PacMan 00F10015 )
		Call  FadeOutMusic  ( 00000000 000001F4 )
		Call  EnablePartnerAI ( )
   6C:  	Call  SetPlayerSpeed    ( *Fixed[6.0] )
   7C:  	Call  PlayerMoveTo      (  -110`  0`  0` )
			Call  PlayerMoveTo      (  -113`  0`  0` )
		Call  SetNpcPos ( .Npc:PacMan  -242`  58`  0` )
		Call  SetNpcJumpscale   ( .Npc:PacMan *Fixed[0.1] )
		Call  GetPlayerPos  ( *Var0 *Var1 *Var2 )
		Sub  *Var0 10`
		Call  NpcJump1  ( .Npc:PacMan  *Var0  10`  *Var2 15` )
   70:  Call  SetPlayerJumpscale    (  1` )
		Thread
			Call  NpcJump1  ( .Npc:PacMan  237`  10` 3` 16` )
			Call  NpcJump1  ( .Npc:PacMan  217`  0` 10` 8` )
		EndThread
   80:  Call  PlayerJump2       ( 237` 0` 0  16` )
		Call  PlaySoundAtNpc    ( .Npc:PacMan 95 00000000 )	%Crash noise
		Call  PlaySoundAtNpc    ( .Npc:PacMan 159 00000000 )	%Boing noise
		Call  ShakeCam  ( .Cam:Default 00000000  30` *Fixed[2.0] )
		Call  SetMusicTrack ( 00000000 .Song:CheerfulBoosMansion 3 00000007 )
		Wait  15`
		Call  SetNpcAnimation   ( .Npc:PacMan 00F10007 )
		Thread
			Loop  2`
			Call  PlaySoundAtNpc    ( .Npc:PacMan 20E5 00000000 )	
			Wait  40`
			EndLoop
		EndThread
		Call  NpcMoveTo ( .Npc:PacMan  110`  15`  45` )
		Wait  10`
		Call  InterpNpcYaw  ( .Npc:PacMan  90`  0` )
		Call  SetNpcAnimation   ( .Npc:PacMan 00F1001F )
		Wait  30`
		Call  SetNpcAnimation   ( .Npc:PacMan 00F10000 )
		Call  SpeakToPlayer ( .Npc:PacMan 00F10000 00F10000 00000000 000E0152 )
		Call  SpeakToPlayer ( .Npc:Partner 00010008 00010001 00000005 000E0153 )
		Call  SpeakToPlayer ( .Npc:PacMan 00F10000 00F10000 00000000 000E0154 )
		Call  SetNpcVar    ( .Npc:PacMan 00000000 1 )
		Wait  1`
		Return
		End
}



#new:Script  $Script_Init_PacMan
{
	Call  SetNpcFlagBits    ( .Npc:PacMan 00000140 .True )
	Call  SetNpcScale   ( .Npc:PacMan *Fixed[1.5] *Fixed[1.5] *Fixed[1.5] )
    Call  BindNpcIdle   ( .Npc:PacMan $Script_Idle_PacMan )
    Call  BindNpcDefeat ( .Npc:PacMan $Script_Defeat_PacMan )
	Return
	End
}

