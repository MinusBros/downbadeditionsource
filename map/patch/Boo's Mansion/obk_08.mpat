#new:Script $Script_Idle_PacMan
{
    0:  Loop
    C:  	Call  GetNpcVar    ( .Npc:Self 00000000 *Var0 )
   20:  	If  *Var0  !=  00000000
   30:  		BreakLoop
   38:  	EndIf
   40:  	Wait  1`
   4C:  EndLoop
		Set   *CheckPacMan .True
		Call  $Function_SaveItems ( )
		Wait  2`
		Call  StartBossBattle   ( .Song:Faith )
		Wait  1`
   48:  Return
   50:  End
}



#new:Script  $Script_Defeat_PacMan
{	
		
		Wait  30`
		Call  SetMusicTrack ( 00000000 .Song:CheerfulBoosMansion 2 00000008 )	%Pac is back
		Call  SpeakToPlayer ( .Npc:PacMan 00F10000 00F10000 00000000 000E0155 )
		Call  NpcFlyTo  ( .Npc:PacMan  111`  38` 15`    40`  0` .Easing:Linear )
		Call  802CFD30  ( .Npc:PacMan 00000004 *Fixed[3.0] *Fixed[3.0] 00000000 00000000 )
		Call  PlaySoundAtNpc    ( .Npc:PacMan 2DF 00000000 )
		Wait  2`
		Thread
			SetF  *Var6  *Fixed[255.0]
	  594:  Loop  255`
	  5A0:  	SubF  *Var6  *Fixed[1.5]
	  5B0:  	Call  802CFD30  ( .Npc:PacMan 00000007 *Var6 00000000 00000000 00000000 )
	  5D4:  	Wait  1`
	  5E0:  EndLoop	
		EndThread
			Set   *Var5 0`
			Call  SetNpcRotation    ( .Npc:PacMan 0` 0` *Var5 )
   E0:  	Loop  18`
   EC:  		Sub   *Var5  20`
   FC:  		Call  SetNpcRotation    ( .Npc:PacMan 0` 0` *Var5 )
  118:  		Wait  1`
  124:  	EndLoop
   E0:  	Loop  18`
   EC:  		Sub   *Var5  40`
   FC:  		Call  SetNpcRotation    ( .Npc:PacMan 0` 0` *Var5 )
  118:  		Wait  1`
  124:  	EndLoop
   E0:  	Loop  18`
   EC:  		Sub   *Var5  40`
   FC:  		Call  SetNpcRotation    ( .Npc:PacMan 0` 0` *Var5 )
  118:  		Wait  1`
  124:  	EndLoop
   E0:  	Loop  36`
   EC:  		Sub   *Var5  60`
   FC:  		Call  SetNpcRotation    ( .Npc:PacMan 0` 0` *Var5 )
  118:  		Wait  1`
  124:  	EndLoop
   E0:  	Loop  72`
   EC:  		Sub   *Var5  80`
   FC:  		Call  SetNpcRotation    ( .Npc:PacMan 0` 0` *Var5 )
  118:  		Wait  1`
  124:  	EndLoop
			Call  ResetCam      ( .Cam:Default *Fixed[3.0] )
			Set  *PacManDefeated .True
			Call  SetMusicTrack     ( 00000000 .Song:CheerfulBoosMansion 00000000 00000008 )
		Return
		End
}


