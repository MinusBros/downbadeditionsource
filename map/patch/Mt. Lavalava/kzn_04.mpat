@	$Script_Main_EnterWalk
{
    0:  Set   *GB_WorldLocation  .Location:MtLavalava
   10:  Call  SetSpriteShading  ( .Shading:kzn_04 )
   20:  Call  SetCamPerspective ( .Cam:Default 00000003  25`  16`  4096` )
   40:  Call  SetCamBGColor     ( .Cam:Default  0`  0`  0` )
   5C:  Call  SetCamEnabled     ( .Cam:Default .True )
   70:  Call  MakeNpcs  ( .True $NpcGroupList_80243F54 )
   84:  ExecWait  $Script_MakeEntities
   90:  Set   *Var0  $Script_80241AE0
   A0:  Exec  EnterWalk
   AC:  Wait  1`
   B8:  Call  SetMusicTrack     ( 00000000 .Song:MtLavalava 00000000 00000008 )
   D4:  Call  PlayAmbientSounds ( .AmbientSounds:Lava1 )
   E4:  Set   *Var0  00000018
   F4:  Exec  $Script_8024184C
  100:  Set   *Var0  00000019
  110:  Exec  $Script_80241968
		If   *KZN04_PartnerBlurb == .False
			Exec $PartnerBlurb
		EndIf
  11C:  Return
  124:  End
}


#new:Script $PartnerBlurb
{
			Wait  20`
			Set  *KZN04_PartnerBlurb .True
			Call  GetCurrentPartnerID   ( *Var0 )
			Switch  *Var0
				Case  ==  .Partner:Goombario % 1
					Call  SetPlayerFlagBits ( 000000C0 .True )
					Call  SpeakToPlayer ( .Npc:Partner 00010008 00010001 00000005 00100160 )
					Wait  80`
					Call  SetPlayerFlagBits ( 000000C0 .False )
				Case  ==  .Partner:Kooper % 2
					Call  SpeakToPlayer ( .Npc:Partner FFFFFFFF FFFFFFFF 00000005 00100161 )
				Case  ==  .Partner:Bombette % 3
					Call  SpeakToPlayer ( .Npc:Partner FFFFFFFF FFFFFFFF 00000005 00100162 ) 
				Case  ==  .Partner:Parakarry % 4
					Call  SpeakToPlayer ( .Npc:Partner FFFFFFFF FFFFFFFF 00000005 00100163 ) 
				Case  ==  .Partner:Bow % 9
					Call  SpeakToPlayer ( .Npc:Partner 00050004 00050001 00000005 00100164 )
				Case  ==  .Partner:Watt % 6
					Call  SpeakToPlayer ( .Npc:Partner 00060004 00060001 00000005 00100165 ) 
				Case  ==  .Partner:Sushie % 7
					Call  SpeakToPlayer ( .Npc:Partner FFFFFFFF FFFFFFFF 00000005 00100166 ) 
				EndSwitch
				Return
				End
}

%Make these firebars worth blue coins
@	$Script_8024231C
{

  [248]  			Call  MakeItemEntity    ( .Item:HeartPiece *Var1 *Var2 *Var3 .ItemSpawnMode:Toss_SpawnAlways 00000000 )
  [2C0]  			Call  MakeItemEntity    ( .Item:HeartPiece *Var1 *Var2 *Var3 .ItemSpawnMode:Toss_SpawnAlways 00000000 )
  [338]  			Call  MakeItemEntity    ( .Item:HeartPiece *Var1 *Var2 *Var3 .ItemSpawnMode:Toss_SpawnAlways 00000000 )
}