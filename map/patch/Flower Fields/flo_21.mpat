%Add something funny if you fall off the map
#new:Script $Script_CheckPos
{
	Label 1
	Wait  1`
	If  *MapFlag[00] == .True
		Return
	EndIf
	Call  GetPlayerPos  ( *Var0 *Var1 *Var2 )
	If *Var1  < -255`
		ExecWait  $NukeBossChecks
		Wait  1`
		Call  802CA988      ( 00000000 *Var2 *Var3 *Var4 *Var5 )
		Call  GotoMap       ( "flo_00" 0000000C )
		Return
	EndIf
	Goto  1
	Return
	End
}

#import AutoSave.mpat

#new:Script $Script_CheckPosSave
{
	Loop
	Wait  1`
	If  *MapFlag[00] == .True
		Return
	EndIf
	Call  GetPlayerPos  ( *Var0 *Var1 *Var2 )
	If *Var0  > 410`
		If  *Var1  == 104`
		Exec  $AutoSaveNoMessage
		BreakLoop
		EndIf
	EndIf
	EndLoop
	Return
	End
}