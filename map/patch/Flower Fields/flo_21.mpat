  140:  		Call  GetCamPitch   ( .Cam:Default *Var2 *Var3 )
  158:  		Call  SetCamPitch   ( .Cam:Default *Var2 *Fixed[-5.5] )
  170:  	EndIf
  178:  	Call  PanToTarget   ( .Cam:Default 00000000 00000001 )
  190:  	Call  $Function_8024004C    ( 00000005 000000B4 0000028A 000000AA 00000000 0000028A 000000CD 00000000 00000096 00000078 )
  1C4:  	Thread
  1CC:  		Call  $Function_802401AC ( )
