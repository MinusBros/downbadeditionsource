@	$Script_80240E3C
{
    0:  Switch  *GB_StoryProgress
    C:  	Case  <  .Story:Ch6_DefeatedHuffNPuff % Change to be if story progress is before beating Huff
   18:  		Set   *Var0  00000000
   28:  		If  *MapVar[A]  ==  00000000
   38:  			Return
   40:  		EndIf
				Call  PlaySound ( 3FD )
   48:  		Set   *GB_StoryProgress  .Story:Ch6_DefeatedHuffNPuff
				Thread
					Wait  150`
					Exec  $AutoSave  %Do this just in case the weird softlock happens	
					Exec  $Script_CheckPos
					If  *LordofThunderRunbackFailsafe == .True
						Wait  200`
						Wait  200`
						Wait  50`
						Goto  SkipCheck
					EndIf
				EndThread
   58:  	Case  ==  .Story:Ch6_DefeatedHuffNPuff % 38
   64:  		Set   *Var0  00000001
   74:  	Default
   7C:  		Return
   84:  EndSwitch
   8C:  If  *Var0  ==  00000000
   9C:  	Call  DisablePlayerInput    ( .True )		
   AC:  	Call  UseSettingsFrom   ( .Cam:Default  650`  205`  0` )
   C8:  	Call  SetCamSpeed       ( .Cam:Default *Fixed[0.6] )
