%Spin Peach and Goombarius
#new:Script  $SpinNpcs	
{
	Label Start
	Thread
		Call  InterpNpcYaw      ( .Npc:Partner  270`  7` )
		Wait  5`
		Call  InterpNpcYaw      ( .Npc:Partner   90`  7` )
		Wait  5`
	EndThread
	Call  InterpNpcYaw      ( 00000000  270`  10` )
	Wait  5`
	Call  InterpNpcYaw      ( 00000000   90`  10` )
	Wait  5`	
	If  *MapFlag[01] == .False
		Goto Start 
	EndIf
	Call  InterpNpcYaw      ( 00000000  90`  8` )
	Call  InterpNpcYaw      ( .Npc:Partner  90`  8` )
	Return
	End
}

#new:Script $Script_ShakeCam
{
		Call  ShakeCam  ( .Cam:Default 00000000  10` *Fixed[0.1] )
		Wait  5`
		Call  ShakeCam  ( .Cam:Default 00000000  10` *Fixed[0.2] )
		Wait  5`
		Call  ShakeCam  ( .Cam:Default 00000000  10` *Fixed[0.3] )
		Wait  5`
    0:  Loop
    C:  	Call  ShakeCam  ( .Cam:Default 00000000  5` *Fixed[0.4] )
   28:  EndLoop
   30:  Return
   38:  End
}



