%Toad_Guard_06
%If you say yes, he'll let you into Peach's room
@ $Script_Interact_80241DD0
{
    0:  Call  GetSelfVar    ( 00000000 *Var0 )
   14:  Switch  *Var0
   20:  	Case  ==  00000000
   2C:  		Call  SpeakToPlayer ( .Npc:Self 00870304 00870301 00000010 0000003D ) % This is Princess Peach's room, but I'm afraid she  ...
				Call  ShowChoice    ( 001E000D ) % Yes No
				If   *Var0  == 0`
					Call  SetSelfVar    ( 00000000 1 )
	   C4:  		Call  ContinueSpeech     ( .Npc:Self 00870304 00870301 00000010 0000003F ) % Boy, you're persistent! I guess I have no choice.. ...
	   E4:  		Wait  10`
	   F0:  		Call  GetPlayerPos      ( *Var0 *Var1 *Var2 )
	  108:  		Call  SetNpcAnimation   ( .NpcID:ToadGuard_06 00870302 )
	  11C:  		If  *Var0  >  00000000
	  12C:  			Set   *Var3  FFFFFFCE
	  13C:  		Else
	  144:  			Set   *Var3  00000032
	  154:  		EndIf
	  15C:  		Call  SetNpcFlagBits    ( .Npc:Self 00000100 .True )
	  174:  		Call  SetNpcSpeed       ( .Npc:Self *Fixed[2.0] )
	  188:  		Call  NpcMoveTo ( .Npc:Self *Var3  -245`  0` )
	  1A4:  		Call  SetNpcFlagBits    ( .Npc:Self 00000100 .False )
	  1BC:  		Call  SetNpcAnimation   ( .NpcID:ToadGuard_06 00870301 )
	  1D0:  		Call  InterpNpcYaw      ( .Npc:Self  180`  5` )
	  1E8:  		Set   *AreaFlag[001]  .True
	  1F8:  		Bind  $Script_ExitSingleDoor_80241138 .Trigger:WallPressA ~Collider:ttn2 00000001 00000000
				Else
					Call  ContinueSpeech    ( .Npc:Self 00870304 00870301 00000010 0000003E ) % variable string ID
				EndIf
  214:  	Default
  21C:  		Call  SpeakToPlayer ( .Npc:Self 00870304 00870301 00000010 00000041 ) % I envy you, Mario...
  23C:  EndSwitch
  268:  Return
  270:  End
}


