%Guard_01
@ $Script_Interact_80240570
{
		Call  GetSelfVar    ( 0 *Var0 )
		Switch  *Var0
			Case == 0
				Call  SpeakToPlayer ( .Npc:Self 00870404 00870401 00000000 0000004A ) % Princess Peach went into her private chambers just ...
				Call  SetSelfVar    ( 0` 1` )
			Case == 1
				Call  SpeakToPlayer ( .Npc:Self 00870404 00870401 00000000 0000004B ) % Alt dialogue
		EndSwitch
   20:  Return
   28:  End
}

