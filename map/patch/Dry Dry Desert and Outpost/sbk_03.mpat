}

	#new:Script $Script_Entry4
{
	SetGroup 0000001B 
	Call     UseExitHeading ( 0000003C 00000002 ) % direction opposing Entry#0
	Exec     ExitWalk 
	Call     GotoMap     	( "arn_22" 0 )
	Wait     00000054 
	Return
	End
}


