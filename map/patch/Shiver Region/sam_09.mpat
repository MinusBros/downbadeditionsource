%Better items for this room.

@	$Script_Main_EnterWalk
{
   [10]  Call  SetSpriteShading  ( .Shading:mim_01 )
}

@	$Script_802412B0
{
    0:  Call  ParentColliderToModel ( ~Collider:o55 ~Model:m1_kabe )
