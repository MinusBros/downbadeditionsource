  1A8:  EndThread
  1B0:  Exec  $Script_80242BC8
  1BC:  Call  GetEntryID    ( *Var0 )
  1CC:  Switch  *Var0
  1D8:  	Case  ==  ~Entry:Entry2
  1E4:  		Set   *VarA  $Script_80241CB4
  1F4:  		Set   *VarB  00000018
  204:  		Exec  $Script_80241110
  210:  	Case  ==  ~Entry:Entry3
  21C:  		Set   *VarA  $Script_80241CB4
  22C:  		Exec  $Script_80240DBC
  238:  	Default
  240:  		Set   *Var0  $Script_80241CB4
  250:  		Exec  EnterWalk
  25C:  EndSwitch
  264:  Wait  1`
		Thread
			Wait  15`
			Exec  $AutoSave
		EndThread
  270:  Return
  278:  End
}

@	$Script_Idle_80242D2C
{
    0:  Call  GetEntryID    ( *Var0 )
   10:  Switch  *Var0
   1C:  	Case  ==  ~Entry:Entry0
   28:  		Call  SetNpcPos ( .Npc:Self  280`  -10`  0` )
   44:  	Case  ==  ~Entry:Entry1
   50:  		Call  BindNpcAI ( .Npc:Self $Script_NpcAI_80242CE0 )
   64:  		Return
   6C:  	Case  ==  ~Entry:Entry2
