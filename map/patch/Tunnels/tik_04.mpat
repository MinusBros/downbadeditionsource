  1DC:  EndIf
  1E4:  Call  SetNpcAnimation   ( .Npc:Self 00270101 )
  1F8:  Call  BindNpcAI ( .Npc:Self $Script_NpcAI_80242CE0 )
  20C:  Return
  214:  End
}



