   C4:  Thread
   CC:  	Set   *Var0  00000002
   DC:  	Set   *Var1  00000000
   EC:  	Set   *Var2  FFFFFF38
   FC:  	Set   *Var3  FFFFFF9C
  10C:  	Set   *Var4  FFFFFE0C
  11C:  	Set   *Var5  00000001
  12C:  	Set   *Var6  00000001
  13C:  	Set   *Var7  00000001
  14C:  	Set   *Var8  00000001
