@	$Script_Main_EnterWalk
{
    0:  Set   *GB_WorldLocation  .Location:GustyGulch
   10:  Call  SetSpriteShading  ( .Shading:None )
   20:  Call  SetCamPerspective ( .Cam:Default 00000003  25`  16`  4096` )
   40:  Call  SetCamBGColor     ( .Cam:Default  0`  0`  0` )
   5C:  Call  SetCamEnabled     ( .Cam:Default .True )
   70:  Call  MakeNpcs  ( .False $NpcGroupList_80241A9C )
   84:  ExecWait  $Script_MakeEntities
   90:  Exec  $Script_80241040
   9C:  Set   *Var0  $Script_802411A8
   AC:  Exec  EnterWalk
   B8:  Wait  1`
		If  *GF_ARN02_Item_DizzyDial  == .False
			Exec  $HustleDrinkBlurb
		EndIf
		If  *GF_ARN02_ItemBlock_RepelGel == .False
			Exec  $RepelGelBlurb
		EndIf
   C4:  Return
   CC:  End
}

#import PartnerBlurb.mpat

#new:Script  $HustleDrinkBlurb
{
				Label 0
				If  *GF_ARN02_Item_DizzyDial  == .False
					Wait  1`
					Goto  0
				EndIf
				Exec  $Blurb
				Return
				End
}

#new:Script  $RepelGelBlurb
{
				Label 1
				If  *GF_ARN02_ItemBlock_RepelGel  == .False
					Wait  1`
					Goto  1
				EndIf
				Exec  $Blurb
				Return
				End
}




@	$Script_MakeEntities
{
    0:  Call  MakeItemEntity    ( .Item:HustleDrink ~Vec3d:Item802412D0 .ItemSpawnMode:Fixed_NeverVanish *GF_ARN02_Item_DizzyDial )
   24:  Call  MakeItemEntity    ( .Item:Letter07 ~Vec3d:Item802412F4 .ItemSpawnMode:Fixed_NeverVanish *GF_ARN02_Item_Letter07 )
   48:  Call  MakeEntity        ( .Entity:YellowBlock ~Vec4d:Entity80241318 .Item:Coin 80000000 )
   70:  Call  AssignBlockFlag   ( *GF_ARN02_ItemBlock_CoinA )
   80:  Call  MakeEntity        ( .Entity:YellowBlock ~Vec4d:Entity80241350 .Item:Coin 80000000 )
   A8:  Call  AssignBlockFlag   ( *GF_ARN02_ItemBlock_CoinB )
   B8:  Call  MakeEntity        ( .Entity:YellowBlock ~Vec4d:Entity80241388 .Item:RepelGel 80000000 )
   E0:  Call  AssignBlockFlag   ( *GF_ARN02_ItemBlock_RepelGel )
   F0:  Return
   F8:  End
}


@	$Script_80241040
{
    0:  Switch  *GB_StoryProgress
    C:  	Case  <  .Story:Ch3_TubbaWokeUp % FFFFFFE3
   18:  		Call  SetMusicTrack ( 00000000 .Song:GustyGulch 00000000 00000008 )
				Call  $Function_SongVariationOff ( )
   34:  	Case  <  .Story:Ch3_DefeatedTubbaBlubba % FFFFFFF0
   40:  		Call  SetMusicTrack ( 00000000 .Song:TubbaEscape 00000000 00000008 )
   5C:  	Default
   64:  		Call  SetMusicTrack ( 00000000 .Song:GustyGulch 00000000 00000008 )
				Call  $Function_SongVariationOff ( )
   80:  EndSwitch
   88:  Call  PlayAmbientSounds ( .AmbientSounds:Wind )
   98:  Return
   A0:  End
}





#new:Function $Function_SongVariationOn
{
    0:  ADDIU     SP, SP, FFE8
    4:  CLEAR     A0
    8:  SW        RA, 10 (SP)
    C:  JAL       8014ABB4
   10:  LI        A1, 1
   14:  LW        RA, 10 (SP)
   18:  LI        V0, 2
   1C:  JR        RA
   20:  ADDIU     SP, SP, 18
}

#new:Function $Function_SongVariationOff
{
    0:  ADDIU     SP, SP, FFE8
    4:  CLEAR     A0
    8:  SW        RA, 10 (SP)
    C:  JAL       8014ABB4
   10:  COPY      A1, A0
   14:  LW        RA, 10 (SP)
   18:  LI        V0, 2
   1C:  JR        RA
   20:  ADDIU     SP, SP, 18
}