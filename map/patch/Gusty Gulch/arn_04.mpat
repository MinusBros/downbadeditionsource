#define .NpcID:Goomba_04            04

#import AutoSave.mpat
#import PartnerBlurb.mpat

@	$Script_Main_EnterWalk
{
    0:  Set   *GB_WorldLocation  .Location:GustyGulch
   10:  Call  SetSpriteShading  ( .Shading:None )
   20:  Call  SetCamPerspective ( .Cam:Default 00000003  25`  16`  4096` )
   40:  Call  SetCamBGColor     ( .Cam:Default  0`  0`  0` )
   5C:  Call  SetCamEnabled     ( .Cam:Default .True )
   70:  Call  MakeNpcs  ( .False $NpcGroupList_80244000 )
   84:  ExecWait  $Script_MakeEntities
   90:  Exec  $Script_802433D0
   9C:  Set   *Var0  $Script_80243538
   AC:  Exec  EnterWalk
   B8:  Wait  1`
		Thread
			Wait  15`
			Exec  $AutoSave
		EndThread
		If  *GF_ARN04_ItemBlock_SuperShroom == .False
			Exec $SuperShroomBlurb
		EndIf
   C4:  Return
   CC:  End
}

#new:Script  $SuperShroomBlurb
{
				Label 0
				If  *GF_ARN04_ItemBlock_SuperShroom  == .False
					Wait  1`
					Goto  0
				EndIf
				Exec  $Blurb
				Return
				End
}

@	$Script_MakeEntities
{
    0:  Call  MakeEntity        ( .Entity:YellowBlock ~Vec4d:Entity80244040 .Item:SuperShroom 80000000 )
   28:  Call  AssignBlockFlag   ( *GF_ARN04_ItemBlock_SuperShroom )
   38:  Call  MakeEntity        ( .Entity:YellowBlock ~Vec4d:Entity80244078 .Item:Coin 80000000 )
   60:  Call  AssignBlockFlag   ( *GF_ARN04_ItemBlock_Coin )
   70:  Call  MakeEntity        ( .Entity:MultiCoinBrick ~Vec4d:Entity802440B0 80000000 )
   94:  Call  AssignBlockFlag   ( *GF_ARN04_MultiCoinBrick )
   A4:  Call  MakeItemEntity    ( .Item:StarPiece ~Vec3d:Item802440E4 .ItemSpawnMode:Fixed_NeverVanish *GF_ARN04_Item_StarPiece )
   C8:  Return
   D0:  End
}


#new:NpcGroup $NpcGroup_Goomba_04
{
	.NpcID:Goomba_04 $NpcSettings_802436B0 ~Vec3f:NPC_Goomba_04 % 360 208 100
	00000400 00000000 00000000 00000000 0000005A
	~Items:20:DriedShroom:A ~HP:Standard:2 ~FP:Standard:2 ~CoinBonus:0:2
	~Movement:NPC_Goomba_04
	~AnimationTable:NPC_Goomba_04 % .Sprite:Goomba
	00000001 00000000 00000000 00000000 % no tattle string
}

@	$NpcGroupList_80244000
{
	00000001 $NpcGroup_80243840 0E090001
	00000001 $NpcGroup_80243A30 0E030001
	00000001 $NpcGroup_80243C20 0E0C0001
	00000001 $NpcGroup_80243E10 0E0E0001
	00000001 $NpcGroup_Goomba_04 0E040001
	00000000 00000000 00000000
}