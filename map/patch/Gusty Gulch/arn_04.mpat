#define .NpcID:Goomba_04            04

#import AutoSave.mpat

@	$Script_Main_EnterWalk
{
    0:  Set   *GB_WorldLocation  .Location:GustyGulch
   10:  Call  SetSpriteShading  ( .Shading:None )
   20:  Call  SetCamPerspective ( .Cam:Default 00000003  25`  16`  4096` )
   40:  Call  SetCamBGColor     ( .Cam:Default  0`  0`  0` )
   5C:  Call  SetCamEnabled     ( .Cam:Default .True )
   70:  Call  MakeNpcs  ( .False $NpcGroupList_80244000 )
   84:  ExecWait  $Script_MakeEntities
   90:  Exec  $Script_802433D0
   9C:  Set   *Var0  $Script_80243538
   AC:  Exec  EnterWalk
   B8:  Wait  1`
		Thread
			Wait  15`
			Exec  $AutoSave
		EndThread
   C4:  Return
   CC:  End
}


#new:NpcGroup $NpcGroup_Goomba_04
