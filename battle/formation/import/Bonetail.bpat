	Thread
		Wait     5
		Call     PlaySoundAtActor 	( .Actor:Self 206D )
		Call     PlaySoundAtActor 	( .Actor:Self 0214 )
		Wait     1E 
		Call     PlaySoundAtActor 	( .Actor:Self 025C )
	EndThread
	Thread
		Call     8026BF48 	( .True )
