#new:Script  $ModifyDefenseInRealTime
{
	Loop
		If  *YoshiCookieIronCleftFlag == .True
			Call  ActorExists   ( .Actor:Enemy0 *Var1 )
			If  *Var1  == .True
				Call  SetDefenseTable   ( .Actor:Enemy0 00000001 $DefenseTable_IronCleftWeak )
			EndIf
			Call  ActorExists   ( .Actor:Enemy1 *Var2 )
			If  *Var2  == .True
				Call  SetDefenseTable   ( .Actor:Enemy1 00000001 $DefenseTable_IronCleftWeak )
			EndIf
		Else
			Call  ActorExists   ( .Actor:Enemy0 *Var1 )
			If  *Var1  == .True
				Call  SetDefenseTable   ( .Actor:Enemy0 00000001 $DefenseTable_IronCleft )
			EndIf
			Call  ActorExists   ( .Actor:Enemy1 *Var2 )
			If  *Var2  == .True
				Call  SetDefenseTable   ( .Actor:Enemy1 00000001 $DefenseTable_IronCleft )
			EndIf			
		EndIf
		Wait  2`
	EndLoop
	Return
	End
}



