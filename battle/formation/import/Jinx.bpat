			CaseOR  ==  .HitResult:Lucky % 5
				Call  SetPartMoveSpeed ( .Actor:Self 00000002 *Fixed[26.0] )
				Call  FlyPartTo       ( .Actor:Self 00000002 -200` 16` *Var2  0`  -5` .Easing:Linear )
				Call  SetPartFlagBits   ( .Actor:Self 00000002 00000001 .True )  %Become invisible
				Call  PlaySoundAtPart   ( .Actor:Self 00000002 2091 )
				Call    ShakeCam     ( 2 0 10` *Fixed[4.0] )
				Call  AddActorDecoration    ( .Actor:Self 00000002 00000000 .Decoration:Sweat )
				Set   *VarA  *Var0
				If  *VarA  ==  .HitResult:Lucky % 5
					Call  EnemyTestTarget   ( .Actor:Self *Var0 ~Flags:DamageType:TriggerLucky 00000000 00000000 00000000 )
				EndIf		
				Wait  16`
				Call  RemoveActorDecoration ( .Actor:Self 00000002 00000000 )
				Wait  5`
				ExecWait $ReturnHome
				Call  EnableIdleScript  ( .Actor:Self 00000001 )
				Call  UseIdleAnimation  ( .Actor:Self .True )
				Return
			EndCaseGroup
		EndSwitch
		Call  GetActorPos 	( .Actor:Player *Var[0] *Var[1] *Var[2] )
		Call  SetPartMoveSpeed ( .Actor:Self 00000002 *Fixed[25.0] )
		Call  FlyPartTo       ( .Actor:Self 00000002 *Var0 *Var1 *Var2  0`  -5` .Easing:Linear )
		Wait  2`
		Call  EnemyDamageTarget     ( .Actor:Self *VarF ~Flags:DamageType:NoContact|MultiBounce|Electric 0000FFFF 00000000 32` 00000020 )
		Call  SetPartFlagBits   ( .Actor:Self 00000002 00000001 .True )  %Become invisible
		Thread
			Call     ShakeCam    	( 00000001 00000000 00000002 *Fixed[1.0] )
			Call     ShakeCam    	( 00000001 00000000 00000002 *Fixed[4.0] )
			Call     ShakeCam    	( 00000001 00000000 00000002 *Fixed[3.0] )
			Call     ShakeCam    	( 00000001 00000000 00000002 *Fixed[2.0] )
			Call     ShakeCam    	( 00000001 00000000 00000002 *Fixed[1.0] )
			Call     ShakeCam    	( 00000001 00000000 00000002 *Fixed[0.5] )
		EndThread
		Wait  4`
		ExecWait  $ReturnHome
		Call  EnableIdleScript  ( .Actor:Self 00000001 )
		Call  UseIdleAnimation  ( .Actor:Self .True )
		Return
		End
}

#new:Script  $ValorUp
{
		Exec  $ShowMessageValorUp
		Wait  24`
		Call	GetActorPos		( .Actor:Self *Var5 *Var6 *Var7 )
		Add		*Var6 7` 
			Set *Var0 8
			Set *Var1 0
			Set *Var2 168`
			Call	 $Function_DebuffEffectUnified ( )	
			Wait 1`
		Call  PlayEffect    ( ~FX:RadialFlowOut:YellowEnergy *Var5 *Var6 *Var7 *Fixed[0.33] 0000001E 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
		Call    PlaySoundAtActor     ( .Actor:Self 000002DD )
		Call    SetActorVar  ( .Actor:Self .Phase 1` )
		Call  SetDefenseTable   ( .Actor:Self 00000001 $DefenseTable_JinxValor )
		Wait  15`
		Return
		End
}

#new:Script  $VigorUp
{
		Exec  $ShowMessageVigorUp
		Wait  24`
		Call	GetActorPos		( .Actor:Self *Var5 *Var6 *Var7 )
		Add		*Var6 7` 
			Set *Var0 168`
			Set *Var1 0`
			Set *Var2 22`
			Call	 $Function_DebuffEffectUnified ( )
			Wait 1`
		Call  PlayEffect    ( ~FX:RadialFlowOut:YellowEnergy *Var5 *Var6 *Var7 *Fixed[0.33] 0000001E 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
		Call    PlaySoundAtActor     ( .Actor:Self 000002DD )
		Call    SetActorVar  ( .Actor:Self .Phase 2` )
		Call    SetActorVar ( .Actor:Self .BombsAwayFlag 1` )
		Wait  15`
		Return
		End
}

#new:Script  $ReturnHome
{	
		Call    UseBattleCamPreset 	( 00000002 )
		Call	MoveBattleCamOver 	( 00000014 )
		Call	SetGoalToHome 	( .Actor:Self )
		Call	SetActorSpeed 	( .Actor:Self *Fixed[28.0] )
		Call	RunToGoal   	( .Actor:Self 00000000 .False )	
		Return
		End
}



#new:Script $Script_HandleEvent_Jinx {
		ExecWait  $JinxHandleEvent  %The actual getting hit script
		Return
		End
}


#new:Script  $HandleDeathJinx
{
   3C:  Call  SetGoalToTarget   ( .Actor:Self )
   4C:  Call  UseBattleCamPreset    ( 0000000E )
   5C:  Call  BattleCamTargetActor  ( .Actor:Self )
   6C:  Call  MoveBattleCamOver (  12` )
		Wait  8`
	Call  GetActorVar  ( .Actor:Self .Phase *Var4 )
	Switch  *Var4
		Case == 0`
			Call  ActorSpeak    ( 0008006B .Actor:Self 00000001 FFFFFFFF FFFFFFFF )
			Call  SetAnimation 	( .Actor:Self 00000001 00F70003 )
			Call  GetEnemyMaxHP ( .Actor:Self *Var2 )
			Call  SetEnemyHP        ( .Actor:Self *Var2 )
			Call  PlaySoundAtActor 	( .Actor:Self 2056 )
			ExecWait  $ValorUp
		Case == 1`
			Call  ActorSpeak    ( 0008006C .Actor:Self 00000001 FFFFFFFF FFFFFFFF )
			Call  SetAnimation 	( .Actor:Self 00000001 00F70003 )
			Call  GetEnemyMaxHP ( .Actor:Self *Var2 )
			Call  SetEnemyHP        ( .Actor:Self *Var2 )
			Call  PlaySoundAtActor 	( .Actor:Self 2056 )		
			ExecWait  $VigorUp
		Case == 2`
			Call  ActorSpeak    ( 0008006D .Actor:Self 00000001 FFFFFFFF FFFFFFFF )	%Simply amazing
			Wait  2`
			Set   *MAC11_JinxBeaten .True		%Set the beaten flag before ending the battle
			Call  $Function_entity_SaveBlock_save_data ( )	%Save just in case
			Wait  6`
			Call  SetActorFlagBits  ( .Actor:Self 00660000 .True ) %Skip turn, no target, no health bar
			Call  SetPartFlagBits   ( .Actor:Self 00000001 00020000 .True )
			Wait  5`
	EndSwitch
	Return
	End
}

#new:Script  $JinxHandleEvent
{
    0:  Call  UseIdleAnimation  ( .Actor:Self .False )
   14:  Call  GetLastEvent      ( .Actor:Self *Var0 )
   28:  Switch  *Var0 
   34:  	Case  ==  .Event:HitCombo % 9
   4C:  		SetConst  *Var0  00000001 
   5C:  		SetConst  *Var1  00F70004 
   6C:  		ExecWait  DoNormalHit 
   40:  	Case  ==  .Event:Hit % A
   4C:  		SetConst  *Var0  00000001 
				Call  GetLastDamage ( .Actor:Self *VarC )
				If  *VarC  <  10` 
					SetConst  *Var1  00F70004
				Else
					SetConst  *Var1  00F70005 
				EndIf
   6C:  		ExecWait  DoNormalHit 
   80:  	Case  ==  .Event:BurnHit % E
   8C:  		SetConst  *Var0  00000001 
   9C:  		SetConst  *Var1  00F70004 
   AC:  		SetConst  *Var2  00F70005 
   BC:  		ExecWait  DoBurnHit 
   C8:  	Case  ==  .Event:BurnDeath % 24
   D4:  		SetConst  *Var0  00000001 
   E4:  		SetConst  *Var1  00F70004 
   F4:  		SetConst  *Var2  00F70005 
  104:  		ExecWait  DoBurnHit 
  110:  		SetConst  *Var0  00000001 
  120:  		SetConst  *Var1  00F70001 
  130:  		ExecWait  $HandleDeathJinx
  13C:  		Return
  144:  	Case  ==  .Event:SpinSmashHit % B
  150:  		SetConst  *Var0  00000001 
  160:  		SetConst  *Var1  00F7000F 
				Call  SetGoalPos    ( .Actor:Self 184`  40` *Var2 )
				Call  SetActorJumpGravity   ( .Actor:Self *Fixed[1.5] )
				Call  SetActorSpeed ( .Actor:Self *Fixed[8.0] )
				Call  JumpToGoal    ( .Actor:Self  10` .False .True .False )	
				Call  PlaySoundAtActor  ( .Actor:Self 2091 )
				Wait  2`
				Call  SetActorJumpGravity   ( .Actor:Self *Fixed[1.0] )
				Call  SetGoalPos    ( .Actor:Self 130`  0` *Var2 )
				Call  JumpToGoal    ( .Actor:Self  5` .False .True .False )
				Call  SetAnimation 	( .Actor:Self 00000001 00F7000A )
				Wait  10`
				ExecWait  $ReturnHome
  17C:  	Case  ==  .Event:SpinSmashDeath % 21
  188:  		SetConst  *Var0  00000001 
  198:  		SetConst  *Var1  00F7000F 
  1A8:  		ExecWait  DoSpinSmashHit 
  1B4:  		SetConst  *Var0  00000001 
  1C4:  		SetConst  *Var1  00F70001 
  1D4:  		ExecWait  $HandleDeathJinx
  1E0:  		Return
  1E8:  	Case  ==  .Event:ShockHit % 2F
  1F4:  		SetConst  *Var0  00000001 
  204:  		SetConst  *Var1  00F70005 
  214:  		ExecWait  DoShockHit 
  220:  		SetConst  *Var0  00000001 
  230:  		SetConst  *Var1  00F70004 
  240:  		ExecWait  DoJumpBack 
  26C:  	Case  ==  .Event:ShockDeath % 26
  278:  		SetConst  *Var0  00000001 
  288:  		SetConst  *Var1  00F7000C 
  298:  		ExecWait  DoShockHit 
  2A4:  		SetConst  *Var0  00000001 
  2B4:  		SetConst  *Var1  00F7000C 
  2C4:  		ExecWait  $HandleDeathJinx
  2D0:  		Return
  2D8:  	CaseOR  ==  00000017 % 17
  2E4:  	CaseOR  ==  .Event:Immune % 19
  2F0:  	CaseOR  ==  .Event:AirLiftFailed % 1F
  2FC:  		SetConst  *Var0  00000001 
  30C:  		SetConst  *Var1  00F70001 
  31C:  		ExecWait  DoImmune 				
				Call  SetAnimationRate      ( .Actor:Self 00000001 *Fixed[1.0] )
  328:  	EndCaseGroup
  330:  	Case  ==  .Event:Death % 20
  33C:  		SetConst  *Var0  00000001 
  34C:  		SetConst  *Var1  00F70005 
  35C:  		ExecWait  DoNormalHit 
  368:  		Wait  10`
  374:  		SetConst  *Var0  00000001 
  384:  		SetConst  *Var1  00F70001 
  394:  		ExecWait  $HandleDeathJinx
  3A0:  		Return
  3A8:  	Case  ==  .Event:RecoverStatus % 31
  3B4:  		SetConst  *Var0  00000001 
  3C4:  		SetConst  *Var1  00F70001 
  3D4:  		ExecWait  DoRecover 
  430:  	Case  ==  .Event:BeginAirLift % 3A
  43C:  		SetConst  *Var0  00000001 
  44C:  		SetConst  *Var1  00F70007 
  45C:  		ExecWait  DoAirLift 
  468:  	Case  ==  .Event:BlowAway % 16
  474:  		SetConst  *Var0  00000001 
  484:  		SetConst  *Var1  00F70001
				Call  SetAnimationRate      ( .Actor:Self 00000001 *Fixed[8.0] )
  494:  		ExecWait  DoBlowAway 
				Call  SetAnimationRate      ( .Actor:Self 00000001 *Fixed[1.0] )
  4A0:  		Return
  4A8:  	Default
  4B0:  EndSwitch
		Call	 RandInt ( 1` *Var6 )
		If  *Var6 == 0`
			Call   SetActorVar ( .Actor:Self .Counter 1` )  %50-50 chance to set counter flag every time he's provoked
		EndIf
  4B8:  Call  UseIdleAnimation  ( .Actor:Self .True )
		Return
		End
}



#new:Script $Script_FP_Drain
{
	Call     GetBattleFlags ( *Var[0] ) %check blocking
	Mul *Var[E] -1`
	If  *Var[0]  &  80000000 
		Add *Var[E] 2
		If *Var[E] > -1`
			Return %skip reduction
		EndIf
		If *Var[E] < -5`
			Set *Var[E] -5`
		EndIf
		Call $Function_FPHeal ( *Var[E] )
		Call	GetActorPos ( .Actor:Player *Var[0] *Var[1] *Var[2] )
		Add	*Var[0] 10
		Add	*Var[1] 12
		Call	PlayEffect ( 00000040 00000001 *Var[0] *Var[1] *Var[2] *Var[E] 00000000 00000000 00000000 00000000 00000000 00000000 )
	Else
		If *Var[E] > -1`
			Return %skip reduction
		EndIf
		If *Var[E] < -5`
			Set *Var[E] -5`
		EndIf
		Call $Function_FPHeal ( *Var[E] )
		Call	GetActorPos ( .Actor:Player *Var[0] *Var[1] *Var[2] )
		Add	*Var[0] 10
		Add	*Var[1] 12
		Call	PlayEffect ( 00000040 00000001 *Var[0] *Var[1] *Var[2] *Var[E] 00000000 00000000 00000000 00000000 00000000 00000000 )
	EndIf
	Return
	End
}


