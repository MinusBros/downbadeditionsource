#new:Script $Script_TakeTurn_Jinx {

%When Jinx is attacked, he has a chance to set what I'm calling the "counter flag"
%If the counter flag is set to 1, Jinx will have a 1 in 3 chance of doing a counterattack on his next turn
		Call   GetActorVar ( .Actor:Self .Counter *Var3 )
		If   *Var3 == 1`
			Call	 RandInt ( 2` *Var4 )
			If  *Var4 == 0`
				Call   SetActorVar ( .Actor:Self .Counter 2` )
			EndIf
		EndIf
		
		
%What phase of the fight is he in?
		Call  GetActorVar (  .Actor:Self .Phase *Var5 )
		Switch  *Var5
			Case == 0`
				 Call   GetActorVar ( .Actor:Self .Counter *Var3 )
				 If  *Var3  == 2`
					ExecWait  $Jinxed
				 EndIf 
			     ExecWait  $JinxMoveList1
			Case == 1`
				 Call   GetActorVar ( .Actor:Self .Counter *Var3 )
				 If  *Var3  == 2`
					ExecWait  $TripleKick
				 EndIf 
				Call  GetActorHP    ( .Actor:Self *Var1 )
				Call  GetEnemyMaxHP ( .Actor:Self *Var2 )
				Mul   *Var1  100`
				Div   *Var1  *Var2 	
				If    *Var1  < 50`	
					ExecWait  $JinxMoveList2Low
					ExecWait  $JinxMoveList2High
				Else
					ExecWait  $JinxMoveList2High
				EndIf
			Case == 2`
				 Call   GetActorVar ( .Actor:Self .Counter *Var3 )
				 If  *Var3  == 2`
					ExecWait  $Quicksilver
				 EndIf 
				Call  GetActorHP    ( .Actor:Self *Var1 )
				Call  GetEnemyMaxHP ( .Actor:Self *Var2 )
				Mul   *Var1  100`
				Div   *Var1  *Var2 	
				If    *Var1  < 50`	
					ExecWait  $JinxMoveList3
					ExecWait  $JinxMoveList2Low
				Else
					ExecWait  $JinxMoveList2Low
				EndIf				
		EndSwitch
		Return
		End
}

#new:Script  $JinxMoveList1
{
	Call	 RandInt ( 2` *VarB )
	If    *VarB == 0`
		ExecWait $TripleKick
	Else
		ExecWait $Jinxed
	EndIf
	If    *Flag[00] == .True
		Set   *Flag[00] .False
		Return
	EndIf
	Set   *Flag[00] .False
	Call  GetActorHP    ( .Actor:Self *Var1 )
	Call  GetEnemyMaxHP ( .Actor:Self *Var2 )
	Mul   *Var1  100`
	Div   *Var1  *Var2 	
	If    *Var1  < 50`
		Set  *Flag[00] .True
		ExecWait $JinxMoveList1
	EndIf
	Return
	End
}

#new:Script  $JinxMoveList2High
{
	Call	 RandInt ( 10` *VarB )
	Switch  *VarB
		Case  < 3`
			ExecWait $Jinxed
		Case  < 7`
			ExecWait $TripleKick
		Case  >= 7`
			ExecWait $Quicksilver
	EndSwitch  
	Return
	End
}


#new:Script  $JinxMoveList2Low
{
	%If beginning phase 3, always do Bombs Away first
	Call   GetActorVar ( .Actor:Self .BombsAwayFlag *Var3 )
	If     *Var3 == 1`
		Call   SetActorVar ( .Actor:Self .BombsAwayFlag 0` )
		ExecWait $BombsAway
		Return
	EndIf
	
	Call	 RandInt ( 10` *VarB )
	Switch  *VarB
		Case  < 2`
			ExecWait $Jinxed
		Case  < 5`
			ExecWait $TripleKick
		Case  < 8`
			ExecWait $Quicksilver
		Case  >= 8`
			ExecWait $SilverBullet
	EndSwitch  
	Return
	End
}


#new:Script  $JinxMoveList3
{
	Call	 RandInt ( 10` *VarB )
	Switch  *VarB
		Case  < 2`
			ExecWait $TripleKick
		Case  < 5`
			ExecWait $Quicksilver
		Case  < 8`
			ExecWait $SilverBullet
		Case >= 8`
			ExecWait $BombsAway
	EndSwitch  
	Return
	End
}


