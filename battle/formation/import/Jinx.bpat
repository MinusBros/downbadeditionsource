%use var0, var1, var2 for color
%var5, var6, var7 for positions
#new:Function $Function_DebuffEffectUnified
{
		PUSH	  RA, S0, S1, S2
    4:  COPY      V0, A0
		LW		  S0, 84 (V0)
		LW		  S1, 88 (V0)
		LW		  S2, 8C (V0)
    C:  LWC1      F0, 98 (V0)				%84 (var0) -> 98 (var5)
   10:  CVT.S.W   F0, F0
   14:  MFC1      A1, F0
   18:  LWC1      F0, 9C (V0)
   1C:  CVT.S.W   F0, F0
   20:  MFC1      A2, F0
   24:  LWC1      F0, A0 (V0)
   28:  CVT.S.W   F0, F0
   2C:  MFC1      A3, F0
   30:  JAL       80070AF0
   34:  ADDIU     A0, R0, 2   
   38:  LW        A0, C (V0)
		COPY	  V1, S0
		%ADDIU     V1, R0, 00 
   40:  SB        V1, 38 (A0)						%color byte 1?
   44:  LW        A0, C (V0)
		COPY	  V1, S1
		%ADDIU     V1, R0, 00
   4C:  SB        V1, 39 (A0)						%color byte 2?
   50:  LW        V1, C (V0)
		COPY	  A0, S2
		%ADDIU     A0, R0, 00
   54:  SB        A0, 3A (V1)						%color byte 3?
   58:  LW        A0, C (V0)
		ADDIU     V1, R0, 00
		COPY	  V1, S0
   60:  SB        V1, 3B (A0)						%color byte 4? (unused?)
   64:  LW        A0, C (V0)
		ADDIU     V1, R0, 00 
		COPY	  V1, S1
   6C:  SB        V1, 3C (A0)						%color byte 5?
   70:  LW        V1, C (V0)
		ADDIU     V0, R0, 40 
		COPY	  A0, S2
   74:  SB        V0, 3D (V1)						%color byte 6?
   7C:  ADDIU     V0, R0, 2   						%return 2
		POP		  RA, S0, S1, S2
   80:  JR        RA
		NOP
}




#new:Function $Function_entity_SaveBlock_save_data
{
    0:  LAW       A0, 800F7B30
    8:  ADDIU     SP, SP, FFE8
    C:  SW        RA, 10 (SP)
   10:  LWC1      F0, 28 (A0)
   14:  LAW       V1, 8007419C
   1C:  TRUNC.W.S F2, F0
   20:  MFC1      V0, F2
   24:  NOP
   28:  SH        V0, 160 (V1)
   2C:  LWC1      F0, 2C (A0)
   30:  TRUNC.W.S F2, F0
   34:  MFC1      V0, F2
   38:  NOP
   3C:  SH        V0, 162 (V1)
   40:  LWC1      F0, 30 (A0)
   44:  LBU       A0, 166 (V1)
   48:  TRUNC.W.S F2, F0
   4C:  MFC1      V0, F2
   50:  JAL       ~Func:fio_save_game
   54:  SH        V0, 164 (V1)
   58:  LW        RA, 10 (SP)
   5C:  JR        RA
   60:  ADDIU     SP, SP, 18
}