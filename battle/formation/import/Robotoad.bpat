.Status:Sleep     .AnimStopR
.Status:Poison    .AnimStopR
.Status:Stop      .AnimStopR
.Status:Static    .AnimIdleR
.Status:Paralyze  .AnimStopR
.Status:Dizzy     .AnimStopR
.Status:Fear      .AnimStopR
