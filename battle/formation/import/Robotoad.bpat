%robotoad
%uses toad guard sprites (I added some in too)

% Define your graphics here
#define .AnimStop	00870500
#define .AnimIdle	00870501
#define .AnimPain	00870519
#define .AnimDead	0087051A
#define .AnimBurn   00870919
#define .AnimBurn2  00870919
#define .AnimStabWindup  0087050C %windup

#define .AnimStopR	00870500
#define .AnimIdleR	00870501
#define .AnimPainR	00870519
#define .AnimDeadR	0087051A
#define .AnimBurnR  00870919
#define .AnimBurn2R  00870919
#define .AnimStabR  00870518 %fast stab
#define .AnimSpearOutR 0087050C
#define .AnimRunR	00870503

#define .AnimStopB	00870700
#define .AnimIdleB	00870701
#define .AnimPainB	00870719
#define .AnimDeadB	0087071A
#define .AnimBurnB  00870919
#define .AnimBurn2B 00870919
#define .AnimStabB  00870717 %slow stab
#define .AnimSpearOutB 0087070C
#define .AnimRunB	00870703

#define .AnimStopY	00870800
#define .AnimIdleY	00870801
#define .AnimPainY	00870819
#define .AnimDeadY	0087081A
#define .AnimBurnY  00870919
#define .AnimBurn2Y 00870919
#define .AnimStabY  0087080C %spear slap
#define .AnimSpearOutY 0087080C
#define .AnimRunY	00870803

#new:Actor $Robotoad
{
% stats
[Index]        2Ab % index from ActorTable.xml
[Level]       120`b %give you some sp 
[MaxHP]       171`b %big robot 
[Coins]         1`b 
[Flags]       00000000 
[StatusTable] $StatusTable_Robotoad 
% ai
[PartsCount]   1`s 
[PartsTable] $PartsTable_Robotoad 
[Script]      $Script_Init_Robotoad
% move effectiveness
[Escape]        0`b 
[Item]          0`b 
[AirLift]       0`b 
[Hurricane]     0`b % Bow's "Spook" as well
[UpAndAway]     0`b 
[PowerBounce]   3`b 
[SpinSmash]     4`b % weight (0-4)
% ui positions
[Size]         24`b  24`b % width height
[HealthBar]     0`b   0`b % dx dy
[StatusTurn]  -10`b  20`b % dx dy
[StatusIcon]   10`b  20`b % dx dy
}

%immune to element it's colored after
%weak to the next element it's colored after

#new:DefenseTable $DefenseTable_Robotoad_Red
{
.Element:Normal 3`
.Element:Fire   99`
.Element:Blast  99`
.Element:Water  1`
.Element:Ice    1`
.Element:Cosmic 2`
.Element:Magic  2`
.Element:End
}

#new:DefenseTable $DefenseTable_Robotoad_Blue
{
.Element:Normal  6`
.Element:Water  99`
.Element:Ice    99`
.Element:Shock   0`
.Element:Quake   0
.Element:Cosmic  5`
.Element:Magic   5`
.Element:End
}

#new:DefenseTable $DefenseTable_Robotoad_Yellow
{
.Element:Normal 4`
.Element:Shock 99`
.Element:Quake 99`
.Element:Fire   2`
.Element:Blast  2`
.Element:Cosmic 3`
.Element:Magic  3`
.Element:End
}

#new:StatusTable $StatusTable_Robotoad
{
.Status:Normal      0`
.Status:Default     0`
.Status:Sleep       0`
.Status:Poison      0`
.Status:Frozen      0`
.Status:Dizzy      50`	%only once though
.Status:Fear        0`
.Status:Static      0`
.Status:Paralyze    0`
.Status:Shrink      0`
.Status:Stop      100`
.Status:DefaultTurnMod    0`
.Status:SleepTurnMod      0`
.Status:PoisonTurnMod    -1`
.Status:FrozenTurnMod     0`
.Status:DizzyTurnMod     -2`
.Status:FearTurnMod       0`
.Status:StaticTurnMod     0`
.Status:ParalyzeTurnMod  -4`
.Status:ShrinkTurnMod    -4`
.Status:StopTurnMod      -1`
.Status:End
}

#new:PartsTable $PartsTable_Robotoad
{
00800000 01000000 001400FF $IdleAnimations_Robotoad_Red $DefenseTable_Robotoad_Red 00000000 00000000 00F60000 00000000 
}

#new:IdleAnimations $IdleAnimations_Robotoad_Red
{
.Status:Normal    .AnimIdleR
