#new:Script $Script_BeforeBattle_Culex
{
   2C:  Set   *Var0  ~Model:hal_bt01:backgroundcover
   3C:  Set   *Var1  00000001
   4C:  Exec  $TexPanner
   2C:  Set   *Var0  ~Model:hal_bt01:backgroundcover2
   3C:  Set   *Var1  00000002
   4C:  Exec  $TexPanner   
   2C:  Set   *Var0  ~Model:hal_bt01:o549
   3C:  Set   *Var1  00000003
   4C:  Exec  $TexPanner 
   2C:  Set   *Var0  ~Model:hal_bt01:o552
   3C:  Set   *Var1  00000004
   4C:  Exec  $TexPanner 
   1C:  Return
   24:  End
}


#new:Script $TexPanner
{
    0:  Set   *VarA  *Var1
   10:  Call  SetTexPanner  ( *Var0 *Var1 )
   24:  Set   *Var0  00000000
   34:  Set   *Var1  00000000
   44:  Loop
   50:  	Call  SetTexPanOffset   ( *VarA 00000000 *Var0 00000000 )
   6C:  	Call  SetTexPanOffset   ( *VarA 00000001 *Var1 00000000 )
   88:  	Sub   *Var0  FFFFFCD4
   98:  	Sub   *Var1  FFFFFC0C
   9C:  	Add   *Var2  0000005A
   AC:  	Add   *Var3  FFFFFF38
   A8:  	Wait  1`
   B4:  EndLoop
   A0:  Return
   A8:  End
}

