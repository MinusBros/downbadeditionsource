  1CC:  			Call  GetActorPos   ( .Actor:Self *Var0 *Var1 *Var2 )
  1E8:  			Call  GetActorSize  ( .Actor:Self *Var3 *Var4 )
  200:  			DivF  *Var3  *Fixed[2.0]
  210:  			AddF  *Var1  *Var3
  220:  			AddF  *Var2  *Fixed[5.0]
  230:  			DivF  *Var3  *Fixed[10.0]
  240:  			Call  PlayEffect    ( ~FX:SmokeBurst:Black *Var0 *Var1 *Var2 *Var3 0000000A 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
  284:  			Wait  5`
  290:  			Call  PlayEffect    ( ~FX:SmokeBurst:Black *Var0 *Var1 *Var2 *Var3 0000000A 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
  2D4:  		EndIf
  2DC:  		Call  ActorSpeak    ( 000C0106 .Actor:Self 00000001 FFFFFFFF FFFFFFFF ) % Oh, no!! That costume was perfect!! Bowser loved i ...
  2FC:  		Wait  30`
  308:  		Set   *Array[0]  00000008
  318:  		Label  14
  324:  		Call  GetActorVar   ( .Actor:Enemy4 00000000 *Var0 )
  33C:  		Wait  1`
  348:  		If  *Var0  !&  00000001
  358:  			Goto  14
  364:  		EndIf
  36C:  		Wait  20`
  378:  		ExecWait  $Script_80222C44
  384:  		Call  GetEnemyMaxHP ( .Actor:Self *Var0 )
  398:  		Call  SetEnemyHP    ( .Actor:Self *Var0 )
  3AC:  		Return
  3B4:  	EndCaseGroup
  3BC:  	CaseOR  ==  .Event:BurnContact % 2C
  3C8:  	CaseOR  ==  .Event:BurnHit % E
  3D4:  		Call  $Function_80218058    ( 00000000 $???_8021A8FC 00000003 )
  3EC:  		Call  $Function_8021817C    ( 00000003 00000023 00000023 00000023 00000000 00000000 00000000 00000000 00000000 00000000 )
  420:  		Set   *Array[0]  00000002
  430:  		Wait  20`
  43C:  		Set   *Array[0]  00000000
  44C:  		Call  $Function_80218058    ( 00000000 $???_8021A8FC 00000000 )
  464:  		Call  GetActorPos   ( .Actor:Self *Var0 *Var1 *Var2 )
  480:  		Call  GetActorSize  ( .Actor:Self *Var3 *Var4 )
  498:  		DivF  *Var3  *Fixed[2.0]
  4A8:  		AddF  *Var1  *Var3
  4B8:  		AddF  *Var2  *Fixed[5.0]
  4C8:  		DivF  *Var3  *Fixed[10.0]
  4D8:  		Call  PlayEffect    ( ~FX:SmokeBurst:Black *Var0 *Var1 *Var2 *Var3 0000000A 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
  51C:  		Wait  5`
				
				Call  GetActorVar   ( .Actor:Self .ArmourBroke *Var5 )
				Switch  *Var5
					Case == 2`
						Call  PlaySoundAtActor  ( .Actor:Self 210C )
						Thread
							Call  ActorSpeak        ( 001F00E6 .Actor:Enemy4 00000001 FFFFFFFF FFFFFFFF )
						EndThread
						Call  SetDefenseTable   ( .Actor:Self 00000001 $DefenseTable_ArmourBroke1 )
						Call  SetActorVar       ( .Actor:Self .ArmourBroke 00000001 )
					Case == 1`
						Call  PlaySoundAtActor  ( .Actor:Self 210C )
						Thread
							Call  ActorSpeak        ( 001F00E6 .Actor:Enemy4 00000001 FFFFFFFF FFFFFFFF )
						EndThread
						Call  SetDefenseTable   ( .Actor:Self 00000001 $DefenseTable_ArmourBroke2 )
						Call  SetActorVar       ( .Actor:Self .ArmourBroke 00000000 )
				EndSwitch
  528:  		Call  PlayEffect    ( ~FX:SmokeBurst:Black *Var0 *Var1 *Var2 *Var3 0000000A 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
  56C:  	EndCaseGroup
  574:  	Default
  57C:  EndSwitch
  584:  Call  UseIdleAnimation  ( .Actor:Self .True )
  598:  Return
  5A0:  End
}

@	$Script_NextTurn_8021F410
{
    0:  UseArray  $End[0]
    C:  Call  UseIdleAnimation  ( .Actor:Self .False )
   20:  Call  GetBattlePhase    ( *Var0 )
   30:  Switch  *Var0
