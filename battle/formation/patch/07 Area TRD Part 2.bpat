@	$Script_HandleEvent_8021E6F0
{
    0:  UseArray  $End[0]
    C:  Call  UseIdleAnimation  ( .Actor:Self .False )
   20:  Call  GetLastEvent      ( .Actor:Self *Var0 )
   34:  Switch  *Var0
   40:  	Case  ==  .Event:HitCombo % 9
   4C:  		Set   *Array[0]  00000002
   5C:  		Wait  20`
   68:  		Set   *Array[0]  00000000
   78:  	Case  ==  .Event:Hit % A
   84:  		Set   *Array[0]  00000002
   94:  		Wait  20`
   A0:  		Set   *Array[0]  00000000
   B0:  	CaseOR  ==  00000017 % 17
   BC:  	CaseOR  ==  .Event:Immune % 19
   C8:  		Set   *Array[0]  00000002
   D8:  		Wait  20`
   E4:  		Set   *Array[0]  00000000
   F4:  	EndCaseGroup
