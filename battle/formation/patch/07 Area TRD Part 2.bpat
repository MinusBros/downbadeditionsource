					If   *DennisHopperYapping1 == .False
	   70:  			Call  UseBattleCamPreset    ( 00000013 )
	   80:  			Call  SetBattleCamTarget    (  -4`  46`  -2` )
	   98:  			Call  SetBattleCamYaw       (  24` )
	   A8:  			Call  SetBattleCamOffsetZ   (  30` )
	   B8:  			Call  SetBattleCamZoom      (  461` )
	   C8:  			Call  MoveBattleCamOver     (  30` )
	   D8:  			Wait  30`
	   E4:  			Call  ActorSpeak    ( 000C00FD .Actor:Self 00000001 FFFFFFFF FFFFFFFF ) % Gah ha ha ha!!!! I've been waiting for you, Mario! ...
						Set  *DennisHopperYapping1 .True
					EndIf
  104:  			Thread
  10C:  				Call  PlaySoundAtActor  ( .Actor:Self 000020FD )
  120:  				Wait  22`
  12C:  				Call  PlaySoundAtActor  ( .Actor:Self 000020FE )
  140:  			EndThread
  148:  			Set   *Array[0]  00000006
  158:  			Wait  30`
					Exec  $MonitorPos

  164:  			Set   *Array[0]  00000000
  174:  			Call  EndActorSpeech    ( .Actor:Self 00000001 FFFFFFFF FFFFFFFF )
  190:  			Call  GetActorVar       ( .Actor:Enemy4 00000000 *Var0 )
  1A8:  			ConstOR  *Var0 00000008
  1B8:  			Call  SetActorVar       ( .Actor:Enemy4 00000000 *Var0 )
  1D0:  			Call  UseBattleCamPreset    ( 00000002 )
  1E0:  			Wait  20`
  1EC:  		EndIf
  1F4:  EndSwitch
  1FC:  Call  UseIdleAnimation  ( .Actor:Self .True )
  210:  Return
  218:  End
}



#new:Script  $MonitorPos
{
	Loop
	Call  GetActorPos       ( .Actor:Player *Var7 *Var8 *Var9 )
		If  *Var7 > -85`
			BreakLoop
		EndIf
		Wait  1`
	Call  GetActorPos       ( .Actor:Partner *Var7 *Var8 *Var9 )
		If  *Var7 > -45`
			BreakLoop
		EndIf
	Wait 1`
	EndLoop
	Set  *FakeBowserTurn .True
	Exec  $ShowSong
	Call  SetMusicTrack ( 00000000 .Song:FakeBowserBattle 00000000 00000008 ) 
	Return
	End
}

#new:Script $ShowSong
{
	Call  ActorSpeak        ( 001F006B .Actor:Enemy4 00000001 FFFFFFFF FFFFFFFF )
	Return 
	End
}

#new:Script $ShowSong2
{
	Call  ActorSpeak        ( 001F006D .Actor:Enemy0 00000001 FFFFFFFF FFFFFFFF )
	Return 
	End
}



%If idle long enough, change to thinking variation
#new:Script  $MonitorPos2
{

	Loop
	Call  GetActorPos       ( .Actor:Player *Var7 *Var8 *Var9 )
		If  *Var7 > -88`
			BreakLoop
		EndIf
		Wait  1`
	Call  GetActorPos       ( .Actor:Partner *Var7 *Var8 *Var9 )
		If  *Var7 > -45`	
			BreakLoop
		EndIf
	Wait 1`
		Add  *Var6  1`
		Switch  *Var6
		Case  > 20`
			Call  $Function_SongVariationOn ( )
		EndSwitch
	Call  GetActorVar   ( .Actor:Enemy4 00000003 *VarA )
	If    *VarA == 1`
		Wait  1`
		BreakLoop
	EndIf
	EndLoop
	Call  $Function_SongVariationOff ( )
	Return
	End
}

