
%Vanish for 3 turns
@ $Function_802A1B14
{
    0:  ADDIU     SP, SP, FFE0
    4:  LI        A1, E
    8:  SW        S0, 10 (SP)
    C:  LAW       S0, 800DC148
   14:  LI        A2, 3
   18:  SW        RA, 18 (SP)
   1C:  SW        S1, 14 (SP)
   20:  LW        S1, 1F4 (S0)
   24:  JAL       ~Func:inflict_status
   28:  COPY      A0, S0
   2C:  SB        R0, 21C (S0)
   30:  LW        V1, 0 (S1)
   34:  ORI       V1, V1, 100
   38:  SW        V1, 0 (S1)
   3C:  LW        RA, 18 (SP)
   40:  LW        S1, 14 (SP)
   44:  LW        S0, 10 (SP)
   48:  LI        V0, 2
   4C:  JR        RA
   50:  ADDIU     SP, SP, 20
}


