%Super does 5.
%Ultra does 7.

@	$Script_UseMove0
{
   [60]  		Set   *VarF  00000002
   [A8]  		Set   *VarF  00000005
   [F0]  		Set   *VarF  00000007
}

@	$Script_802A3168
{
    0:  Call  GetMenuSelection  ( *Var0 *Var1 *Var2 )
   18:  Switch  *Var1
   24:  	Case  ==  .Item:Nothing % 0
   30:  		ExecWait  $Script_802A1B40
   3C:  	Case  ==  .Item:Jump % 1
   48:  		ExecWait  $Script_802A2000
   54:  	Case  ==  .Item:SpinJump % 2
   60:  		ExecWait  $Script_802A23E8
   6C:  EndSwitch
   74:  Call  GetActionSuccessCopy  ( *Var0 )
   84:  Switch  *Var0
   90:  	Case  >  00000000
   9C:  		Call  GetMenuSelection  ( *Var0 *Var1 *Var2 )
   B4:  		Switch  *Var1
   C0:  			Case  ==  .Item:Nothing % 0
   CC:  				Call  StartRumble   ( 00000007 )
   DC:  				Thread
   E4:  					Call  ShakeCam  ( .Cam:Battle 00000000  10` *Fixed[1.3] )
  100:  				EndThread
  108:  			Case  ==  .Item:Jump % 1
  114:  				Call  StartRumble   ( 00000008 )
  124:  				Thread
  12C:  					Call  ShakeCam  ( .Cam:Battle 00000000  10` *Fixed[1.6] )
  148:  				EndThread
  150:  			Case  ==  .Item:SpinJump % 2
  15C:  				Call  StartRumble   ( 00000009 )
  16C:  				Thread
  174:  					Call  ShakeCam  ( .Cam:Battle 00000000  10` *Fixed[1.9] )
  190:  				EndThread
  198:  		EndSwitch
  1A0:  	Default
  1A8:  		Call  GetMenuSelection  ( *Var0 *Var1 *Var2 )
  1C0:  		Switch  *Var1
  1CC:  			Case  ==  .Item:Nothing % 0
  1D8:  				Call  StartRumble   ( 00000007 )
  1E8:  				Thread
  1F0:  					Call  ShakeCam  ( .Cam:Battle 00000000  2` *Fixed[1.3] )
  20C:  				EndThread
  214:  			Case  ==  .Item:Jump % 1
  220:  				Call  StartRumble   ( 00000008 )
  230:  				Thread
  238:  					Call  ShakeCam  ( .Cam:Battle 00000000  2` *Fixed[1.6] )
  254:  				EndThread
  25C:  			Case  ==  .Item:SpinJump % 2
  268:  				Call  StartRumble   ( 00000009 )
  278:  				Thread
  280:  					Call  ShakeCam  ( .Cam:Battle 00000000  2` *Fixed[1.9] )
  29C:  				EndThread
  2A4:  		EndSwitch
  2AC:  EndSwitch
  2B4:  Call  UseBattleCamPreset    ( 0000002C )
  2C4:  Wait  1`
  2D0:  Call  PlayerTestEnemy       ( *Var0 ~Flags:DamageType:Smash 00000019 00000000 00000000 00000010 )
  2F4:  If  *Var0  ==  .HitResult:Miss % 6
  304:  	ExecWait  $Script_802A1A64
  310:  	Return
  318:  EndIf
  320:  Call  DidActionSucceed  ( *Var0 )
  330:  Switch  *Var0
  33C:  	Case  >  .False
  348:  		Call  GetMenuSelection  ( *Var0 *Var1 *Var2 )
  360:  		Switch  *Var1
  36C:  			Case  ==  .Item:Nothing % 0
  378:  				Call  PlaySoundAtActor  ( .Actor:Player .Sound:HitNormal )
  38C:  			Case  ==  .Item:Jump % 1
  398:  				Call  PlaySoundAtActor  ( .Actor:Player .Sound:Empty_010E )
  3AC:  			Case  ==  .Item:SpinJump % 2
  3B8:  				Call  PlaySoundAtActor  ( .Actor:Player .Sound:Empty_010E )
  3CC:  		EndSwitch
				Call  GetStatusFlags    ( .Actor:Player *VarC )
				If  *VarC  !&  ~Flags:StatusFlags:Static
					Call  PlayerDamageEnemy ( *Var0 ~Flags:DamageType:Smash 00000019 00000000 *VarF 00000070 )
				Else
					Call  PlayerDamageEnemy ( *Var0 ~Flags:DamageType:Smash|Electric 00000019 00000000 *VarF 00000070 )
				EndIf
  3F8:  	Default
  400:  		Call  GetMenuSelection  ( *Var0 *Var1 *Var2 )
  418:  		Switch  *Var1
  424:  			Case  ==  .Item:Nothing % 0
  430:  				Call  PlaySoundAtActor  ( .Actor:Player .Sound:HitNormal )
  444:  			Case  ==  .Item:Jump % 1
  450:  				Call  PlaySoundAtActor  ( .Actor:Player .Sound:Empty_010E )
  464:  			Case  ==  .Item:SpinJump % 2
  470:  				Call  PlaySoundAtActor  ( .Actor:Player .Sound:Empty_010E )
  484:  		EndSwitch
				Call  GetStatusFlags    ( .Actor:Player *VarC )
				If  *VarC  !&  ~Flags:StatusFlags:Static
					Call  PlayerDamageEnemy ( *Var0 ~Flags:DamageType:Smash 00000019 00000000 *VarE 00000030 )
				Else
					Call  PlayerDamageEnemy ( *Var0 ~Flags:DamageType:Smash|Electric 00000019 00000000 *VarE 00000030 )
				EndIf
				Call  PlaySound ( 0000008B )	%Boooo!
  4B0:  EndSwitch
  4B8:  Switch  *Var0
  4C4:  	CaseOR  ==  00000001 % 1
  4D0:  	CaseOR  ==  00000003 % 3
  4DC:  		ExecWait  $Script_802A18AC
  4E8:  	EndCaseGroup
  4F0:  	CaseOR  ==  .HitResult:Hit % 0
  4FC:  	CaseOR  ==  .HitResult:QuakeImmune % 2
  508:  		ExecWait  $Script_802A1A64
  514:  	EndCaseGroup
  51C:  EndSwitch
  524:  Return
  52C:  End
}


%+1 for normal hammer, +2 for super hammer, +3 for ultra

@ $Script_UseMove1
{
    0:  Call     GetMenuSelection 	( *Var[0] *Var[1] *Var[2] )
   18:  Switch  *Var[1] 
   24:  	Case  ==  00000000 
				Call $Function_CheckFirstAttack ( *Var[C] )
				If *Var[C] == 0
   30: 		 		Set  *Var[9]  00000001 
				Else
					Set  *Var[9]  00000002 
				EndIf
   40:  		SetConst  *Var[A]  0003000F 
   50:  		SetConst  *Var[B]  00030011 
   60:  		SetConst  *Var[C]  00030012 
   70:  	Case  ==  00000001 
				Call $Function_CheckFirstAttack ( *Var[C] )
				If *Var[C] == 0
   7C: 		 		Set  *Var[9]  00000002 
				Else
					Set  *Var[9]  00000004 
				EndIf
   8C:  		SetConst  *Var[A]  00030016 
   9C:  		SetConst  *Var[B]  00030017 
   AC:  		SetConst  *Var[C]  00030019 
   BC:  	Case  ==  00000002 
				Call $Function_CheckFirstAttack ( *Var[C] )
				If *Var[C] == 0
   C8: 		 		Set  *Var[9]  00000003 
				Else
					Set  *Var[9]  00000006 
				EndIf
   D8:  		SetConst  *Var[A]  0003001D 
   E8:  		SetConst  *Var[B]  0003001E 
   F8:  		SetConst  *Var[C]  00030020 
  108:  EndSwitch
  110:  Call     SetGoalToTarget 	( .Actor:Player )
  120:  Call     AddGoalPos 	( .Actor:Player 00000000 00000000 00000000 )
  13C:  Call     GetGoalPos  	( .Actor:Self *Var[0] *Var[1] *Var[2] )
  158:  Sub  *Var[0]  00000020 
  168:  Set  *Var[1]  00000000 
  178:  Call     SetActorPos 	( .Actor:Self *Var[0] *Var[1] *Var[2] )
  194:  Call     8024E664 ( 0000002B )
  1A4:  Call     SetAnimation 	( .Actor:Player 00000000 *Var[A] )
  1BC:  Wait     00000008 
  1C8:  Call     SetAnimation 	( .Actor:Player 00000000 *Var[B] )
  1E0:  Wait     00000003 
  1EC:  Call     UseBattleCamPreset 	( 0000002C )
  1FC:  Call     SetAnimation 	( .Actor:Player 00000000 *Var[C] )
  214:  Call     GetMenuSelection 	( *Var[0] *Var[1] *Var[2] )
  22C:  Switch  *Var[1] 
  238:  	Case  ==  00000000 
  244:  		Call     PlaySoundAtActor 	( .Actor:Player 00002115 )
  258:  		Call     80254218 ( 00000007 )
  268:  		Thread
  270:  			Call     ShakeCam    	( 00000001 00000000 0000000A *Fixed[1.3007812] )
  28C:  		EndThread
  294:  	Case  ==  00000001 
  2A0:  		Call     PlaySoundAtActor 	( .Actor:Player 00002116 )
  2B4:  		Call     80254218 ( 00000008 )
  2C4:  		Thread
  2CC:  			Call     ShakeCam    	( 00000001 00000000 0000000A *Fixed[1.6005859] )
  2E8:  		EndThread
  2F0:  	Case  ==  00000002 
  2FC:  		Call     PlaySoundAtActor 	( .Actor:Player 00002117 )
  310:  		Call     80254218 ( 00000009 )
  320:  		Thread
  328:  			Call     ShakeCam    	( 00000001 00000000 0000000A *Fixed[1.9003906] )
  344:  		EndThread
  34C:  EndSwitch
  354:  Call     UseBattleCamPreset 	( 0000002C )
  364:  Wait     00000001 
  370:  Call     PlayerTestEnemy 	( *Var[0] 00000040 00000019 00000000 00000000 00000010 )
  394:  If  *Var[0]  ==  00000006 
  3A4:  	ExecWait $Script_802A1A64 
  3B0:  	Return
  3B8:  EndIf
  3C0:  Call     GetMenuSelection 	( *Var[0] *Var[1] *Var[2] )
  3D8:  Switch  *Var[1] 
  3E4:  	Case  ==  00000000 
  3F0:  		Call     PlaySoundAtActor 	( .Actor:Player 000000E9 )
  404:  	Case  ==  00000001 
  410:  		Call     PlaySoundAtActor 	( .Actor:Player 0000010E )
  424:  	Case  ==  00000002 
  430:  		Call     PlaySoundAtActor 	( .Actor:Player 0000010E )
  444:  EndSwitch
		Call  GetStatusFlags    ( .Actor:Player *VarC )
		If  *VarC  !&  ~Flags:StatusFlags:Static
			Call     PlayerDamageEnemy 	( *Var[0] ~Flags:DamageType:Smash 00000019 00000000 *Var[9] 00000030 )
		Else
			Call     PlayerDamageEnemy 	( *Var[0] ~Flags:DamageType:Smash|Electric 00000019 00000000 *Var[9] 00000030 )
		EndIf
  470:  ExecWait $Script_802A18AC 
  47C:  Return
  484:  End
}


